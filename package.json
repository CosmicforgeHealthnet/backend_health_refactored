{
  "name": "cosmicforge_health_backend",
  "version": "1.0.0",
  "main": "src/server.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon src/server.js",
    "start": "cross-env NODE_ENV=production node src/server.js",
    "typeorm": "typeorm",
    "migration:generate": "cross-env NODE_ENV=development npx typeorm migration:generate --dataSource src/config/database.js --outputJs",
    "migration:revert": "cross-env NODE_ENV=development npx typeorm migration:revert --dataSource src/config/database.js",
    "migration:create": "cross-env NODE_ENV=development npx typeorm migration:create --outputJs",
    "migration:run": "cross-env NODE_ENV=development npx typeorm migration:run --dataSource src/config/database.js",
    "migration:show": "cross-env NODE_ENV=development npx typeorm migration:show --dataSource src/config/database.js",
    "swagger:bundle": "node src/docs/mergeSwaggerComponents.js",
    "swagger-components-merge": "node src/docs/mergeSwaggerComponents.js",
    "build:pharmacy-swagger": "node src/features/pharmacy/docs/pharmacySwaggerMerger.js",
    "setup:sos-docs": "node src/features/firstaid/scripts/setup-sos-docs.js",
    "build:lab-swagger": "node src/features/LAB/docs/swagger_merger.js",
    "build:main-swagger": "node src/docs/mergeSwaggerComponents.js",
    "build:sos-swagger": "node src/features/firstaid/content/sosSwaggerMerger.js",
    "build:all-swagger": "npm run build:main-swagger && npm run build:pharmacy-swagger",
    "test": "jest",
    "start:cron": "node src/cron.js",
    "lint": "eslint .",
    "generate-postman": "node src/docs/generatePostman.js",
    "docker:dev": "docker-compose up --build",
    "docker:prod": "docker-compose up -d --build"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^11.0.1",
    "@google-cloud/vision": "^5.2.0",
    "archiver": "^7.0.1",
    "aws-sdk": "^2.1692.0",
    "axios": "^1.9.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.2.1",
    "form-data": "^4.0.0",
    "google-auth-library": "^9.15.1",
    "googleapis": "^150.0.1",
    "handlebars": "^4.7.8",
    "helmet": "^7.0.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.29.4",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "node-cache": "^5.1.2",
    "node-cron": "^4.0.6",
    "nodemailer": "^7.0.3",
    "pdf2pic": "^3.2.0",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "redis": "^4.7.1",
    "reflect-metadata": "^0.1.14",
    "sharp": "^0.34.2",
    "socket.io": "^4.8.1",
    "speakeasy": "^2.0.0",
    "swagger-ui-express": "^4.6.3",
    "tesseract.js": "^6.0.1",
    "typeorm": "^0.3.24",
    "xlsx": "^0.18.5",
    "xss": "^1.0.15",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-cli": "^4.0.4",
    "@eslint/css": "^0.10.0",
    "@eslint/js": "^9.32.0",
    "@eslint/json": "^0.13.1",
    "@eslint/markdown": "^7.1.0",
    "cross-env": "^7.0.3",
    "deepmerge": "^4.3.1",
    "eslint": "^9.32.0",
    "eslint-plugin-unicorn": "^57.0.0",
    "fs-extra": "^11.3.0",
    "globals": "^16.3.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "yaml": "^2.8.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "directories": {
    "test": "tests"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": ""
}