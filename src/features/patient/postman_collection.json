{
  "info": {
    "name": "CosmicForge - Patient Feature",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get patient FAQs",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/faq/patient",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "faq",
            "patient"
          ],
          "variable": []
        },
        "description": "Get FAQs specifically for patients"
      }
    },
    {
      "name": "Get all patients for the current user",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/fhir/patients",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "fhir",
            "patients"
          ],
          "variable": []
        },
        "description": "Retrieve a paginated list of all patients that have FHIR resources \nassociated with the authenticated user.\n"
      }
    },
    {
      "name": "Get patient summary",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/fhir/patients/{patientId}/summary",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "fhir",
            "patients",
            ":patientId",
            "summary"
          ],
          "variable": []
        },
        "description": "Get a comprehensive summary of all FHIR resources for a specific patient,\nincluding resource type breakdown and sensitivity levels.\n"
      }
    },
    {
      "name": "Get all files for a specific patient",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/fhir/patients/{patientId}/files",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "fhir",
            "patients",
            ":patientId",
            "files"
          ],
          "variable": []
        },
        "description": "Retrieve all FHIR files associated with a specific patient.\nSupports filtering by resource type and sensitivity level.\n"
      }
    }
  ]
}
