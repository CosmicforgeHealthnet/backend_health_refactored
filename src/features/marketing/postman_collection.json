  },
  "item": [
    {
      "name": "Get signup analytics by period",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/marketing/analytics/signups",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "marketing",
            "analytics",
            "signups"
          ],
          "variable": []
        },
        "description": "Retrieve signup analytics grouped by time period (day, week, or month).\nReturns total signups broken down by doctors and patients.\n"
      }
    },
    {
      "name": "Get total signup counts",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/marketing/analytics/totals",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "marketing",
            "analytics",
            "totals"
          ],
          "variable": []
        },
        "description": "Retrieve overall total counts for all users, doctors, and patients.\n"
      }
    },
    {
      "name": "Get user email list",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/marketing/emails",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "marketing",
