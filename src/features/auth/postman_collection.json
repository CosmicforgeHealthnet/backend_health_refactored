    {
      "name": "Generate MFA setup data (QR code and secret)",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auth/mfa/setup",
          "host": [
            "{{baseUrl}}"
