      "name": "Upload images and get permanent URLs",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/documents/images/upload",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "documents",
            "images",
            "upload"
          ],
          "variable": []
        },
        "description": "Upload one or more images and receive permanent, publicly accessible URLs.\n\n**Key Features:**\n- Returns permanent URLs (no expiration)\n- Images are publicly accessible\n- Automatic folder creation/management\n- Multiple URL formats provided\n"
      }
    },
