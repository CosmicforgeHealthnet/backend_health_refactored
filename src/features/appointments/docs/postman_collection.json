{
    "info": {
        "name": "CosmicForge - Appointments Feature",
        "description": "Appointment booking, management, and scheduling API endpoints",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:3000",
            "type": "string"
        }
    ],
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{accessToken}}",
                "type": "string"
            }
        ]
    },
    "item": [
        {
            "name": "Timezone Management",
            "item": [
                {
                    "name": "Update user timezone",
                    "request": {
                        "method": "PATCH",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"timezone\": \"Africa/Lagos\" // (REQUIRED) IANA timezone string\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/appointments/timezone",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "appointments",
                                "timezone"
                            ]
                        },
                        "description": "Update user's timezone preference"
                    }
                },
                {
                    "name": "Get available timezones",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/appointments/timezones",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "appointments",
                                "timezones"
                            ]
                        },
                        "description": "Get list of supported timezones"
                    }
                }
            ]
        },
        {
            "name": "Appointment CRUD",
            "item": [
                {
                    "name": "Get all appointments (Filters)",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/appointments?patientId=&doctorId=&status=&appointmentDate=&paymentStatus=&startDate=&endDate=&page=1&limit=10",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "appointments"
                            ],
                            "query": [
                                {
                                    "key": "patientId",
                                    "value": "",
                                    "description": "(OPTIONAL) Filter by patient ID"
                                },
                                {
                                    "key": "doctorId",
                                    "value": "",
                                    "description": "(OPTIONAL) Filter by doctor ID"
                                },
                                {
                                    "key": "status",
                                    "value": "",
                                    "description": "(OPTIONAL) Filter by status (e.g. pending, confirmed, completed, cancelled)"
                                },
                                {
                                    "key": "appointmentDate",
                                    "value": "",
                                    "description": "(OPTIONAL) Filter by specific date (YYYY-MM-DD)"
                                },
                                {
                                    "key": "paymentStatus",
                                    "value": "",
                                    "description": "(OPTIONAL) Filter by payment status"
                                },
                                {
                                    "key": "startDate",
                                    "value": "",
                                    "description": "(OPTIONAL) Range start date"
                                },
                                {
                                    "key": "endDate",
                                    "value": "",
                                    "description": "(OPTIONAL) Range end date"
                                },
                                {
                                    "key": "page",
                                    "value": "1",
                                    "description": "(OPTIONAL) Page number (default: 1)"
                                },
                                {
                                    "key": "limit",
                                    "value": "10",
                                    "description": "(OPTIONAL) Items per page (default: 10)"
                                }
                            ]
                        },
                        "description": "Get all appointments with optional filters and pagination"
                    }
                },
                {
                    "name": "Get appointment analytics",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/appointments/analytics?patientId=&doctorId=&startDate=&endDate=",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "appointments",
                                "analytics"
                            ],
                            "query": [
                                {
                                    "key": "patientId",
                                    "value": "",
                                    "description": "(OPTIONAL) Filter by patient ID"
                                },
                                {
                                    "key": "doctorId",
                                    "value": "",
                                    "description": "(OPTIONAL) Filter by doctor ID"
                                },
                                {
                                    "key": "startDate",
                                    "value": "",
                                    "description": "(OPTIONAL) Start date for range filter (YYYY-MM-DD)"
                                },
                                {
                                    "key": "endDate",
                                    "value": "",
                                    "description": "(OPTIONAL) End date for range filter (YYYY-MM-DD)"
                                }
                            ]
                        },
                        "description": "Get aggregated appointment analytics (counts, status breakdown, revenue)"
                    }
                },
                {
                    "name": "Create appointment",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"doctorId\": \"doctor-uuid\", // (REQUIRED)\n  \"patientId\": \"patient-uuid\", // (REQUIRED)\n  \"date\": \"2024-02-15\", // (REQUIRED) YYYY-MM-DD\n  \"time\": \"14:00\", // (REQUIRED) HH:mm\n  \"type\": \"consultation\", // (REQUIRED)\n  \"notes\": \"Initial consultation for health checkup\", // (OPTIONAL)\n  \"duration\": 30, // (OPTIONAL) Duration in minutes\n  \"timezone\": \"Africa/Lagos\" // (OPTIONAL) Override user timezone\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/appointments",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "appointments"
                            ]
                        },
                        "description": "Create a new appointment"
                    }
                },
                {
                    "name": "Update appointment",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"date\": \"2024-02-16\",\n  \"time\": \"15:00\",\n  \"notes\": \"Updated notes\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/appointments/:id",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "appointments",
                                ":id"
                            ],
                            "variable": [
                                {
                                    "key": "id",
                                    "value": "",
                                    "description": "Appointment UUID"
                                }
                            ]
                        },
                        "description": "Update an existing appointment"
                    }
                },
                {
                    "name": "Get appointment by ID",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/appointments/:id",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "appointments",
                                ":id"
                            ],
                            "variable": [
                                {
                                    "key": "id",
                                    "value": "",
                                    "description": "Appointment UUID"
                                }
                            ]
                        },
                        "description": "Get appointment details by ID"
                    }
                },
                {
                    "name": "Reschedule appointment",
                    "request": {
                        "method": "PATCH",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"appointmentDate\": \"2024-02-20\", // (REQUIRED) New date\n  \"appointmentTime\": \"16:00\", // (REQUIRED) New time\n  \"reason\": \"Conflict with schedule\", // (OPTIONAL)\n  \"duration\": 45 // (OPTIONAL)\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/appointments/:id/reschedule",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "appointments",
                                ":id",
                                "reschedule"
                            ],
                            "variable": [
                                {
                                    "key": "id",
                                    "value": "",
                                    "description": "Appointment UUID"
                                }
                            ]
                        },
                        "description": "Reschedule an appointment"
                    }
                },
                {
                    "name": "Cancel appointment",
                    "request": {
                        "method": "DELETE",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/appointments/:id",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "appointments",
                                ":id"
                            ],
                            "variable": [
                                {
                                    "key": "id",
                                    "value": "",
                                    "description": "Appointment UUID"
                                }
                            ]
                        },
                        "description": "Cancel an appointment"
                    }
                }
            ]
        },
        {
            "name": "Doctor Approval",
