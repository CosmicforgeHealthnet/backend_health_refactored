{
  "openapi": "3.0.3",
  "info": {
    "title": "CosmicForge Vendor Orders & Wallet API",
    "description": "Order management and wallet system for CosmicForge vendors and patients",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "http://localhost:3000/api", "description": "Development server" }
  ],
  "tags": [
    { "name": "Orders (Patient)",   "description": "Patient — checkout, pay, view and cancel orders" },
    { "name": "Orders (Vendor)",    "description": "Vendor — view, complete and cancel incoming orders" },
    { "name": "Vendor Wallet",      "description": "Vendor wallet balance and transaction history" },
    { "name": "Shipments (Vendor)", "description": "Vendor — dispatch orders and mark delivered" },
    { "name": "Shipments (Patient)","description": "Patient — track shipment status" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing or invalid access token",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "BadRequest": {
        "description": "Invalid request body or parameters",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "error":   { "type": "string" }
        }
      },
      "OrderObject": {
        "type": "object",
        "properties": {
          "id":                { "type": "string", "format": "uuid" },
          "orderNumber":       { "type": "string", "example": "ORD-1717632000000-AB3CD" },
          "cartId":            { "type": "string", "format": "uuid" },
          "status":            { "type": "string", "enum": ["pending", "processing", "completed", "cancelled"] },
          "paymentStatus":     { "type": "string", "enum": ["unpaid", "paid", "refunded"] },
          "subtotal":          { "type": "number", "example": 10500 },
          "platformFeeAmount": { "type": "number", "example": 735, "description": "7% platform fee (system-controlled)" },
          "vendorAmount":      { "type": "number", "example": 9765, "description": "93% credited to vendor wallet" },
          "currency":          { "type": "string", "example": "NGN" },
          "paymentAuthUrl":    { "type": "string", "nullable": true },
          "patientNote":       { "type": "string", "nullable": true },
          "vendorNote":        { "type": "string", "nullable": true },
          "deliveryMethod":    { "type": "string", "nullable": true },
          "deliveryAddress":   { "type": "string", "nullable": true },
          "cancelledBy":       { "type": "string", "nullable": true },
          "cancelledAt":       { "type": "string", "format": "date-time", "nullable": true },
          "completedAt":       { "type": "string", "format": "date-time", "nullable": true },
          "paidAt":            { "type": "string", "format": "date-time", "nullable": true },
          "vendor": {
            "type": "object",
            "properties": {
              "id":           { "type": "string" },
              "businessName": { "type": "string" },
              "logoUrl":      { "type": "string", "nullable": true }
            }
          },
          "patient": {
            "type": "object",
            "properties": {
              "id":       { "type": "string" },
              "fullName": { "type": "string" },
              "email":    { "type": "string" }
            }
          },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "WalletSummary": {
        "type": "object",
        "properties": {
          "availableBalanceNgn": { "type": "number", "example": 45000 },
          "pendingClearanceNgn": { "type": "number", "example": 0 },
          "totalEarningsNgn":    { "type": "number", "example": 98000 },
          "isActive":    { "type": "boolean" },
          "isFrozen":    { "type": "boolean" },
          "frozenReason": { "type": "string", "nullable": true },
          "lastPayoutAt": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "ShipmentObject": {
        "type": "object",
        "properties": {
          "id":                  { "type": "string", "format": "uuid" },
          "orderId":             { "type": "string", "format": "uuid" },
          "status":              { "type": "string", "enum": ["pending", "dispatched", "in_transit", "delivered", "failed"] },
          "deliveryMethod":      { "type": "string", "enum": ["pickup", "delivery"] },
          "deliveryAddress":     { "type": "string", "nullable": true },
          "trackingNumber":      { "type": "string", "nullable": true },
          "logisticsProvider":   { "type": "string", "nullable": true, "example": "gig_logistics" },
          "estimatedDeliveryAt": { "type": "string", "format": "date-time", "nullable": true },
          "dispatchedAt":        { "type": "string", "format": "date-time", "nullable": true },
          "deliveredAt":         { "type": "string", "format": "date-time", "nullable": true },
          "vendorNotes":         { "type": "string", "nullable": true },
          "createdAt":           { "type": "string", "format": "date-time" },
          "updatedAt":           { "type": "string", "format": "date-time" }
        }
      },
      "WalletTransaction": {
        "type": "object",
        "properties": {
          "id":              { "type": "string", "format": "uuid" },
          "type":            { "type": "string", "enum": ["credit", "debit"] },
          "category":        { "type": "string", "enum": ["order_payment", "payout", "refund", "adjustment"] },
          "status":          { "type": "string", "enum": ["completed", "pending", "failed"] },
          "amountNgn":       { "type": "number" },
          "balanceAfterNgn": { "type": "number" },
          "orderId":         { "type": "string", "nullable": true },
          "reference":       { "type": "string", "nullable": true },
          "description":     { "type": "string" },
          "createdAt":       { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "paths": {
    "/vendor/orders/checkout/{cartId}": {
      "post": {
        "tags": ["Orders (Patient)"],
        "summary": "Initiate checkout from a confirmed cart",
        "description": "Creates a vendor order from a confirmed cart. Cart must have been confirmed by the vendor first. Returns order details including the payment URL after calling /pay.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "cartId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "201": {
            "description": "Checkout initiated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success":           { "type": "boolean" },
                    "message":           { "type": "string" },
                    "orderId":           { "type": "string" },
                    "orderNumber":       { "type": "string" },
                    "status":            { "type": "string" },
                    "paymentStatus":     { "type": "string" },
                    "subtotal":          { "type": "number" },
                    "platformFeeAmount": { "type": "number" },
                    "vendorAmount":      { "type": "number" },
                    "currency":          { "type": "string" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/vendor/orders/{orderId}/pay": {
      "post": {
        "tags": ["Orders (Patient)"],
        "summary": "Initiate payment for an order",
        "description": "Returns a Paystack payment URL. Redirect the user to paymentUrl to complete payment. Order activates automatically via webhook.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "orderId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "Payment URL returned",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success":    { "type": "boolean" },
                    "message":    { "type": "string" },
                    "paymentUrl": { "type": "string", "description": "Redirect patient here" },
                    "reference":  { "type": "string" },
                    "amount":     { "type": "number" },
                    "orderId":    { "type": "string" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/vendor/orders/my": {
      "get": {
        "tags": ["Orders (Patient)"],
        "summary": "Get my orders (patient)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["pending", "processing", "completed", "cancelled"] } },
          { "name": "page",   "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit",  "in": "query", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": {
          "200": {
            "description": "Orders list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "orders":  { "type": "array", "items": { "$ref": "#/components/schemas/OrderObject" } },
                    "total":   { "type": "integer" },
                    "page":    { "type": "integer" },
                    "limit":   { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/vendor/orders/my/{orderId}": {
      "get": {
        "tags": ["Orders (Patient)"],
        "summary": "Get a single order (patient)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "orderId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Order detail", "content": { "application/json": { "schema": { "type": "object", "properties": { "success": { "type": "boolean" }, "order": { "$ref": "#/components/schemas/OrderObject" } } } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/vendor/orders/my/{orderId}/cancel": {
      "post": {
        "tags": ["Orders (Patient)"],
        "summary": "Cancel an order (patient)",
        "description": "Only pending, unpaid orders can be cancelled by the patient.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "orderId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Order cancelled", "content": { "application/json": { "schema": { "type": "object", "properties": { "success": { "type": "boolean" }, "message": { "type": "string" }, "order": { "$ref": "#/components/schemas/OrderObject" } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/vendor/orders/vendor": {
      "get": {
        "tags": ["Orders (Vendor)"],
        "summary": "Get all incoming orders (vendor)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "status",        "in": "query", "schema": { "type": "string", "enum": ["pending", "processing", "completed", "cancelled"] } },
          { "name": "paymentStatus", "in": "query", "schema": { "type": "string", "enum": ["unpaid", "paid", "refunded"] } },
          { "name": "page",          "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit",         "in": "query", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": {
          "200": {
            "description": "Vendor orders list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "orders":  { "type": "array", "items": { "$ref": "#/components/schemas/OrderObject" } },
                    "total":   { "type": "integer" },
                    "page":    { "type": "integer" },
                    "limit":   { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/vendor/orders/vendor/{orderId}": {
      "get": {
        "tags": ["Orders (Vendor)"],
        "summary": "Get a single order (vendor)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "orderId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Order detail", "content": { "application/json": { "schema": { "type": "object", "properties": { "success": { "type": "boolean" }, "order": { "$ref": "#/components/schemas/OrderObject" } } } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/vendor/orders/vendor/{orderId}/complete": {
      "post": {
        "tags": ["Orders (Vendor)"],
        "summary": "Mark order as completed",
        "description": "Vendor marks the order as fulfilled. Order must be in processing status.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "orderId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Order completed", "content": { "application/json": { "schema": { "type": "object", "properties": { "success": { "type": "boolean" }, "message": { "type": "string" }, "order": { "$ref": "#/components/schemas/OrderObject" } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/vendor/orders/vendor/{orderId}/cancel": {
      "post": {
        "tags": ["Orders (Vendor)"],
        "summary": "Cancel an order (vendor)",
        "description": "Only pending, unpaid orders can be cancelled by the vendor.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "orderId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Order cancelled", "content": { "application/json": { "schema": { "type": "object", "properties": { "success": { "type": "boolean" }, "message": { "type": "string" }, "order": { "$ref": "#/components/schemas/OrderObject" } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/vendor/wallet/summary": {
      "get": {
        "tags": ["Vendor Wallet"],
        "summary": "Get wallet balance summary",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Wallet summary",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "wallet":  { "$ref": "#/components/schemas/WalletSummary" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/vendor/shipments/providers": {
      "get": {
        "tags": ["Shipments (Vendor)"],
        "summary": "Get supported logistics providers",
        "description": "Returns a list of logistics providers for the dispatch form dropdown. No auth required.",
        "responses": {
          "200": {
            "description": "Providers list",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "success": { "type": "boolean" }, "providers": { "type": "array", "items": { "type": "object", "properties": { "key": { "type": "string" }, "label": { "type": "string" } } } } } } } }
          }
        }
      }
    },
    "/vendor/shipments/vendor/{orderId}/dispatch": {
      "post": {
        "tags": ["Shipments (Vendor)"],
        "summary": "Dispatch an order (create shipment)",
        "description": "Vendor dispatches a paid, processing order. Creates the shipment record and notifies the patient. For `pickup`, patient is told the order is ready. For `delivery`, a tracking number and provider can be added.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "orderId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["deliveryMethod"],
                "properties": {
                  "deliveryMethod":      { "type": "string", "enum": ["pickup", "delivery"] },
                  "deliveryAddress":     { "type": "string", "description": "Required if deliveryMethod is delivery" },
                  "trackingNumber":      { "type": "string", "nullable": true },
                  "logisticsProvider":   { "type": "string", "nullable": true, "example": "gig_logistics" },
                  "estimatedDeliveryAt": { "type": "string", "format": "date-time", "nullable": true },
                  "vendorNotes":         { "type": "string", "nullable": true }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Order dispatched", "content": { "application/json": { "schema": { "type": "object", "properties": { "success": { "type": "boolean" }, "message": { "type": "string" }, "shipment": { "$ref": "#/components/schemas/ShipmentObject" } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/vendor/shipments/vendor/{orderId}/delivered": {
      "post": {
        "tags": ["Shipments (Vendor)"],
        "summary": "Mark order as delivered",
        "description": "Vendor confirms delivery. Marks the shipment as delivered and the order as completed. Patient is notified.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "orderId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "200": { "description": "Delivered", "content": { "application/json": { "schema": { "type": "object", "properties": { "success": { "type": "boolean" }, "message": { "type": "string" }, "shipment": { "$ref": "#/components/schemas/ShipmentObject" } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/vendor/shipments/vendor/{orderId}": {
      "get": {
        "tags": ["Shipments (Vendor)"],
        "summary": "Get shipment for an order",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "orderId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "200": { "description": "Shipment detail", "content": { "application/json": { "schema": { "type": "object", "properties": { "success": { "type": "boolean" }, "shipment": { "$ref": "#/components/schemas/ShipmentObject" } } } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/vendor/shipments/my/{orderId}": {
      "get": {
        "tags": ["Shipments (Patient)"],
        "summary": "Track my shipment",
        "description": "Patient retrieves shipment/delivery status for their order.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "orderId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "200": { "description": "Shipment detail", "content": { "application/json": { "schema": { "type": "object", "properties": { "success": { "type": "boolean" }, "shipment": { "$ref": "#/components/schemas/ShipmentObject" } } } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/vendor/wallet/transactions": {
      "get": {
        "tags": ["Vendor Wallet"],
        "summary": "Get wallet transaction history",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "category", "in": "query", "schema": { "type": "string", "enum": ["order_payment", "payout", "refund", "adjustment"] } },
          { "name": "page",     "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit",    "in": "query", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": {
          "200": {
            "description": "Transaction list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success":      { "type": "boolean" },
                    "transactions": { "type": "array", "items": { "$ref": "#/components/schemas/WalletTransaction" } },
                    "total":  { "type": "integer" },
                    "page":   { "type": "integer" },
                    "limit":  { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
