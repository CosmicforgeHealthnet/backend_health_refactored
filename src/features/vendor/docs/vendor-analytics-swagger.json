{
  "openapi": "3.0.3",
  "info": {
    "title": "CosmicForge Vendor Analytics API",
    "description": "Vendor dashboard analytics — overview, sales performance, product performance, and promotion spend.",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "http://localhost:3000/api", "description": "Development server" }
  ],
  "tags": [
    { "name": "Vendor Analytics", "description": "All vendor analytics endpoints" }
  ],
  "paths": {
    "/vendor/analytics/overview": {
      "get": {
        "tags": ["Vendor Analytics"],
        "summary": "Dashboard overview",
        "description": "Returns high-level KPIs: total orders, revenue, product counts, pending carts, active promotions, and total promotion spend.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Overview metrics",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OverviewResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/vendor/analytics/sales": {
      "get": {
        "tags": ["Vendor Analytics"],
        "summary": "Sales performance over time",
        "description": "Returns confirmed order counts and revenue grouped by the selected period. Defaults: daily = last 7 days, weekly = last 4 weeks, monthly = last 12 months.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "query",
            "name": "period",
            "schema": { "type": "string", "enum": ["daily", "weekly", "monthly"], "default": "daily" },
            "description": "Grouping period"
          },
          {
            "in": "query",
            "name": "from",
            "schema": { "type": "string", "format": "date" },
            "description": "Start date (ISO 8601). Overrides default range."
          },
          {
            "in": "query",
            "name": "to",
            "schema": { "type": "string", "format": "date" },
            "description": "End date (ISO 8601). Defaults to today."
          }
        ],
        "responses": {
          "200": {
            "description": "Sales data grouped by period",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SalesResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/vendor/analytics/products": {
      "get": {
        "tags": ["Vendor Analytics"],
        "summary": "Product performance",
        "description": "Returns top 10 products by order count, low-stock alerts (stock < 10), and product counts by approval status.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Product performance data",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProductPerformanceResponse" }
              }
            }
          }
        }
      }
    },
    "/vendor/analytics/promotions": {
      "get": {
        "tags": ["Vendor Analytics"],
        "summary": "Promotion spend and performance",
        "description": "Returns spend breakdown by promotion type and status, plus 5 most recent paid promotions.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Promotion analytics",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PromotionPerformanceResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "responses": {
      "Unauthorized": {
        "description": "Unauthorized",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "BadRequest": {
        "description": "Bad request",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      }
    },
    "schemas": {
      "OverviewResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "overview": {
            "type": "object",
            "properties": {
              "orders": {
                "type": "object",
                "properties": {
                  "total":   { "type": "integer", "description": "Total confirmed orders (carts)" },
                  "pending": { "type": "integer", "description": "Carts submitted but not yet confirmed" }
                }
              },
              "revenue": {
                "type": "object",
                "properties": {
                  "total":    { "type": "string", "example": "125000.00" },
                  "currency": { "type": "string", "example": "NGN" }
                }
              },
              "products": {
                "type": "object",
                "properties": {
                  "total":    { "type": "integer" },
                  "approved": { "type": "integer" },
                  "pending":  { "type": "integer" }
                }
              },
              "promotions": {
                "type": "object",
                "properties": {
                  "active":     { "type": "integer" },
                  "totalSpend": { "type": "string", "example": "55000.00" }
                }
              }
            }
          }
        }
      },
      "SalesResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "sales": {
            "type": "object",
            "properties": {
              "period": { "type": "string", "enum": ["daily", "weekly", "monthly"] },
              "from":   { "type": "string", "format": "date-time" },
              "to":     { "type": "string", "format": "date-time" },
              "data": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "period":  { "type": "string", "example": "2025-05-01" },
                    "orders":  { "type": "integer" },
                    "revenue": { "type": "string", "example": "18500.00" }
                  }
                }
              }
            }
          }
        }
      },
      "ProductPerformanceResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "products": {
            "type": "object",
            "properties": {
              "topProducts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "productId":      { "type": "string", "format": "uuid" },
                    "title":          { "type": "string" },
                    "orderCount":     { "type": "integer" },
                    "totalUnitsSold": { "type": "integer" },
                    "revenue":        { "type": "string" }
                  }
                }
              },
              "lowStock": {
                "type": "array",
                "description": "Approved products with stock below 10",
                "items": {
                  "type": "object",
                  "properties": {
                    "id":            { "type": "string" },
                    "title":         { "type": "string" },
                    "stockQuantity": { "type": "integer" },
                    "category":      { "type": "string" }
                  }
                }
              },
              "statusBreakdown": {
                "type": "object",
                "example": { "approved": 12, "pending": 3, "failed": 1 }
              }
            }
          }
        }
      },
      "PromotionPerformanceResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "promotions": {
            "type": "object",
            "properties": {
              "byType": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type":       { "type": "string" },
                    "count":      { "type": "integer" },
                    "totalSpend": { "type": "string" }
                  }
                }
              },
              "byStatus": {
                "type": "object",
                "example": { "active": 2, "completed": 5, "pending": 1 }
              },
              "recentPromotions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id":        { "type": "string" },
                    "title":     { "type": "string" },
                    "type":      { "type": "string" },
                    "status":    { "type": "string" },
                    "pricePaid": { "type": "number" },
                    "startDate": { "type": "string", "format": "date-time" },
                    "endDate":   { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "error":   { "type": "string" }
        }
      }
    }
  }
}
