<div style="padding: 30px; font-family: Arial, sans-serif;">
    <!-- Heading -->
    <h1 style="font-size: 20px; font-weight: bold; margin-bottom: 20px;">
        Reset Your Wallet Password
    </h1>

    <!-- Greeting -->
    <p style="font-size: 16px; margin-bottom: 10px;">
        Hey <strong>{{fullName}}</strong>,
    </p>

    <!-- Intro message -->
    <p style="font-size: 16px; line-height: 1.5; margin-bottom: 20px;">
        We received a request to reset your wallet password. If you didn't make this request, 
        you can safely ignore this email.
    </p>

    <!-- Instructions -->
    <p style="font-size: 16px; margin-bottom: 30px;">
        To reset your wallet password, click the button below:
    </p>

    <!-- Button -->
    {{> button url=resetUrl text="Reset Wallet Password" }}

    <!-- Security Info -->
    <div style="background: linear-gradient(135deg, #fef3c7, #fde68a); border-left: 4px solid #f59e0b; padding: 20px; border-radius: 8px; margin: 25px 0;">
        <p style="font-size: 14px; margin: 0; color: #92400e;">
            <strong>Important Security Information:</strong>
        </p>
        <ul style="font-size: 14px; color: #92400e; margin: 10px 0; padding-left: 20px;">
            <li>This link will expire in <strong>{{expiresInMinutes}} minutes</strong> for security reasons</li>
            <li>The link can only be used once</li>
            <li>Your new password must be at least 4 characters long</li>
        </ul>
    </div>

    <!-- Fallback Link -->
    <div style="background-color: #f8fafc; padding: 20px; border-radius: 6px; margin: 20px 0;">
        <p style="font-size: 13px; color: #6b7280; margin: 0 0 10px 0; font-weight: bold;">
            If the button doesn't work:
        </p>
        <p style="font-size: 13px; color: #6b7280; margin: 0; word-break: break-all;">
            Copy and paste this link into your browser:<br />
            <a href="{{resetUrl}}" style="color: #272EA7; text-decoration: underline;">{{resetUrl}}</a>
        </p>
    </div>

    <!-- Warning Notice -->
    <div style="background-color: #fee2e2; border-left: 4px solid #ef4444; padding: 20px; border-radius: 6px; margin: 25px 0;">
        <p style="font-size: 14px; margin: 0; color: #dc2626;">
            <strong>Didn't request this?</strong><br>
            If you didn't request this password reset, please contact our support team immediately. 
            Your account security is our top priority.
        </p>
    </div>

    <!-- Help Section -->
    <div style="background-color: #eff6ff; border-left: 4px solid #3b82f6; padding: 20px; border-radius: 6px; margin: 25px 0;">
        <p style="font-size: 14px; margin: 0; color: #1e40af;">
            <strong>Need Help?</strong><br>
            If you're having trouble resetting your password or have questions about wallet security, 
            our support team is here to help 24/7.
        </p>
    </div>

    <!-- Sign off -->
    <p style="font-size: 14px; color: #6b7280; margin-top: 30px;">
        Best regards,<br>
        <strong>The CosmicForge Security Team</strong>
    </p>

</div>