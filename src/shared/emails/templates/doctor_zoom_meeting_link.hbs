<!-- Doctor Zoom Meeting Link Template -->
<div style="padding: 30px; font-family: Arial, sans-serif;">
    <!-- Status Banner -->
    <div style="background: linear-gradient(135deg, #059669, #047857); text-align: center; padding: 20px; border-radius: 8px; margin-bottom: 30px;">
        <h2 style="margin: 0; font-size: 16px; color: white; font-weight: bold;">🎥 Zoom Meeting Ready</h2>
    </div>

    <!-- Greeting -->
    <p style="font-size: 16px; margin-bottom: 10px;">
        Hello <strong>Dr. {{doctorName}}</strong>,
    </p>

    <!-- Main message -->
    <p style="font-size: 16px; line-height: 1.5; margin-bottom: 30px;">
        Your Zoom meeting is ready for your appointment with <strong>{{patientName}}</strong>.
    </p>

    <!-- Appointment Details -->
    <div style="background-color: #f0fdf4; border-left: 4px solid #16a34a; padding: 20px; border-radius: 8px; margin: 20px 0;">
        <h3 style="color: #15803d; margin-top: 0; font-size: 16px; font-weight: bold; margin-bottom: 15px;">
            Appointment Details
        </h3>
        <p style="font-size: 14px; margin: 5px 0; color: #166534;">
            <strong>Patient:</strong> {{patientName}}
        </p>
        <p style="font-size: 14px; margin: 5px 0; color: #166534;">
            <strong>Date & Time:</strong> {{appointmentDate}} at {{appointmentTime}}
        </p>
        <p style="font-size: 14px; margin: 5px 0; color: #166534;">
            <strong>Duration:</strong> {{duration}} minutes
        </p>
        <p style="font-size: 14px; margin: 5px 0; color: #166534;">
            <strong>Appointment ID:</strong> #{{appointmentId}}
        </p>
    </div>

    <!-- Host Meeting Details -->
    <div style="background-color: #f0f9ff; border-left: 4px solid #0284c7; padding: 20px; border-radius: 8px; margin: 20px 0;">
        <h3 style="color: #0c4a6e; margin-top: 0; font-size: 16px; font-weight: bold; margin-bottom: 15px;">
            🎯 Host Controls
        </h3>
        
        <!-- Join as Host -->
        <div style="background: white; padding: 15px; border-radius: 8px; margin: 10px 0;">
            <p style="font-size: 14px; margin: 5px 0; color: #0c4a6e;">
                <strong>Host Meeting Link:</strong>
            </p>
            <a href="{{meetingLink}}" style="color: #2563eb; text-decoration: none; font-weight: bold; font-size: 16px; word-break: break-all;">
                {{meetingLink}}
            </a>
        </div>

        <!-- Host Credentials -->
        <div style="background: white; padding: 15px; border-radius: 8px; margin: 10px 0;">
            <p style="font-size: 14px; margin: 5px 0; color: #0c4a6e;">
                <strong>Meeting ID:</strong> {{zoomMeetingId}}
            </p>
            {{#if meetingPassword}}
            <p style="font-size: 14px; margin: 5px 0; color: #0c4a6e;">
                <strong>Passcode:</strong> {{meetingPassword}}
            </p>
            {{/if}}
            {{#if hostKey}}
            <p style="font-size: 14px; margin: 5px 0; color: #dc2626;">
                <strong>Host Key:</strong> {{hostKey}} <em>(Keep confidential)</em>
            </p>
            {{/if}}
        </div>
    </div>

    <!-- Start Meeting Button -->
    <div style="text-align: center; margin: 30px 0;">
        <a href="{{meetingLink}}" style="background: #059669; color: white; padding: 15px 30px; text-decoration: none; border-radius: 8px; font-weight: bold; display: inline-block;">
            Start Meeting as Host
        </a>
    </div>

    <!-- Host Instructions -->
    <div style="background-color: #fef3c7; border-left: 4px solid #f59e0b; padding: 20px; border-radius: 8px; margin: 20px 0;">
        <h3 style="color: #92400e; margin-top: 0; font-size: 16px; font-weight: bold; margin-bottom: 15px;">
            📋 Host Checklist
        </h3>
        <p style="color: #92400e; margin: 5px 0; font-size: 14px;">
            • Join 5 minutes early to prepare the meeting room
        </p>
        <p style="color: #92400e; margin: 5px 0; font-size: 14px;">
            • Use your Host Key if prompted for additional controls
        </p>
        <p style="color: #92400e; margin: 5px 0; font-size: 14px;">
            • Enable waiting room to admit the patient when ready
        </p>
        {{!-- <p style="color: #92400e; margin: 5px 0; font-size: 14px;">
            • Record the session if required (with patient consent)
        </p> --}}
        <p style="color: #92400e; margin: 5px 0; font-size: 14px;">
            • Test your camera and microphone before starting
        </p>
    </div>

    <!-- Privacy & Security Note -->
    <div style="background-color: #fef2f2; border-left: 4px solid #ef4444; padding: 20px; border-radius: 8px; margin: 20px 0;">
        <h3 style="color: #dc2626; margin-top: 0; font-size: 16px; font-weight: bold; margin-bottom: 15px;">
            🔒 Privacy & Security
        </h3>
        <p style="color: #991b1b; margin: 5px 0; font-size: 14px;">
            • This meeting is for medical consultation purposes only
        </p>
        <p style="color: #991b1b; margin: 5px 0; font-size: 14px;">
            • Ensure you're in a private, HIPAA-compliant environment
        </p>
        <p style="color: #991b1b; margin: 5px 0; font-size: 14px;">
            • Do not share meeting credentials with unauthorized persons
        </p>
        <p style="color: #991b1b; margin: 5px 0; font-size: 14px;">
            • End the meeting promptly when consultation is complete
        </p>
    </div>

    <!-- Dashboard Link -->
    <div style="text-align: center; margin: 30px 0;">
        <a href="{{dashboardLink}}" style="color: #3964EA; text-decoration: none; font-weight: bold;">
            📋 View My Appointments
        </a>
    </div>
</div>