<div style="padding: 30px; font-family: Arial, sans-serif;">
    <!-- Heading -->
    <h1 style="font-size: 20px; font-weight: bold; margin-bottom: 20px;">
        Subscription Expiring Soon
    </h1>

    <!-- Greeting -->
    <p style="font-size: 16px; margin-bottom: 10px;">
        Hey <strong>{{fullName}}</strong>,
    </p>

    <!-- Main message -->
    <p style="font-size: 16px; line-height: 1.5; margin-bottom: 30px;">
        Warning: your <strong>{{planName}}</strong> subscription expires in 
        <strong>{{daysRemaining}} day(s)</strong>. Renew now to avoid interruption.
    </p>

    <!-- Warning notice -->
    <div style="background-color: #fef3c7; border-left: 4px solid #f59e0b; padding: 20px; border-radius: 8px; margin: 20px 0;">
        <p style="color: #92400e; margin: 0; font-size: 14px;">
            <strong>Important:</strong> If your subscription expires, you won't be able to offer consultations until you renew. 
            Keep serving your patients by renewing today.
        </p>
    </div>

    <!-- Button -->
    <div style="text-align: center; margin: 30px 0;">
        {{> button url=link text="Renew Now" }}
    </div>

    <!-- Fallback link -->
    <p style="font-size: 14px; color: #555; word-break: break-all; margin: 20px 0;">
        If the button doesn't work, copy and paste this link into your browser:<br />
        <a href="{{link}}" style="color: #272EA7;">{{link}}</a>
    </p>

    <!-- Sign off -->
    <p style="margin-top: 30px; font-size: 14px;">
        The CosmicForge Team
    </p>

</div>