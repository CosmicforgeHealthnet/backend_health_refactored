<!-- src/emails/templates/spin_wheel_reminder.hbs -->
<!-- ============================================ -->

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>Ready for Another Spin? - CosmicForge Health</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f4f4f4; color: black; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;">
    <table align="center" width="100%" cellpadding="0" cellspacing="0" style="max-width: 600px; background-color: #ffffff; margin: 40px auto; border-radius: 8px; box-shadow: 0 0 10px rgba(0,0,0,0.1); overflow: hidden;">
        <tr>
            <td style="padding: 30px; text-align: center; background: linear-gradient(135deg, #ec4899 0%, #db2777 100%);">
                <img src="https://backend.cosmicforge-healthnet.com/images/e47c6604-d9cc-4fb2-9c87-b4d9337c2156.png" alt="CosmicForge Health" style="max-height: 60px;">
            </td>
        </tr>
        <tr>
            <td style="padding: 40px 30px;">
                <div style="text-align: center; margin-bottom: 30px;">
                    <div style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color: white; padding: 12px 24px; border-radius: 25px; display: inline-block; font-weight: bold; font-size: 14px; margin-bottom: 20px;">
                        🎰 SPIN AGAIN
                    </div>
                </div>

                <h1 style="font-size: 24px; color: #333; margin: 0 0 20px 0; font-weight: 600; text-align: center;">
                    Hey {{userName}}!
                </h1>
                
                <p style="font-size: 16px; line-height: 1.6; color: #555; margin: 0 0 20px 0; text-align: center;">
                    Your daily spin is ready! Try your luck on our reward wheel and win amazing discounts on your health subscriptions.
                </p>

                <!-- Spin Wheel CTA -->
                <div style="background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%); border-radius: 12px; padding: 25px; margin: 30px 0; border-left: 4px solid #f59e0b;">
                    <h2 style="color: #92400e; margin: 0 0 15px 0; font-size: 18px; font-weight: 600;">
                        🎁 Today's Prizes Include:
                    </h2>
                    
                    <ul style="color: #78350f; margin: 0; padding-left: 20px; line-height: 1.8;">
                        <li><strong>10% OFF</strong> subscriptions</li>
                        <li><strong>20% OFF</strong> subscriptions</li>
                        <li><strong>30% OFF</strong> subscriptions</li>
                        <li><strong>Free consultation</strong> sessions</li>
                        <li>And more exciting rewards!</li>
                    </ul>
                    
                    <div style="text-align: center; margin: 25px 0 0 0;">
                        <a href="{{spinLink}}"
                            style="background: linear-gradient(135deg, #ec4899 0%, #db2777 100%); color: #ffffff; padding: 16px 32px; text-decoration: none; border-radius: 8px; font-weight: bold; font-size: 16px; display: inline-block; box-shadow: 0 4px 12px rgba(236, 72, 153, 0.3);">
                            🎰 SPIN THE WHEEL NOW
                        </a>
                    </div>
                </div>

                <!-- Benefits -->
                <div style="margin-top: 30px; padding: 20px; background: linear-gradient(135deg, #f0f7ff 0%, #e0f2fe 100%); border-radius: 8px; border-left: 4px solid #2563eb;">
                    <h3 style="color: #1e40af; margin: 0 0 12px 0; font-size: 16px;">
                        ⭐ Why Spin Today?
                    </h3>
                    <ul style="color: #1e3a8a; margin: 0; padding-left: 20px; line-height: 1.6;">
                        <li>Free to play - no purchase required</li>
                        <li>One spin every 24 hours</li>
                        <li>Instant reward notification</li>
                        <li>Easy email verification process</li>
                        <li>Apply discounts immediately</li>
                    </ul>
                </div>

                <div style="text-align: center; margin: 30px 0;">
                    <a href="{{dashboardLink}}" style="background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%); color: #ffffff; padding: 12px 24px; text-decoration: none; border-radius: 6px; font-weight: bold; margin: 0 10px; display: inline-block;">
                        🎁 View My Rewards
                    </a>
                </div>

                <p style="margin-top: 30px; font-size: 14px; color: #777; line-height: 1.5; text-align: center;">
                    Good luck spinning! <a href="{{supportLink}}" style="color: #2563eb; text-decoration: none;">Need help?</a>
                    <br><br>
                    <strong>The CosmicForge Health Team</strong>
                </p>
            </td>
        </tr>
        <tr>
            <td style="padding: 20px; background: linear-gradient(135deg, #ec4899 0%, #db2777 100%); color: #ffffff; text-align: center; font-size: 12px;">
                <p style="margin: 0; opacity: 0.9;">
                    &copy; {{currentYear}} CosmicForge Health. All rights reserved.
                </p>
            </td>
        </tr>
    </table>
</body>
</html>