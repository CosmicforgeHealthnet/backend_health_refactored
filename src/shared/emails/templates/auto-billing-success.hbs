
<!-- Auto-Billing Success Template -->
<div style="padding: 30px; font-family: Arial, sans-serif;">
    <!-- Heading -->
    <h1 style="font-size: 20px; font-weight: bold; margin-bottom: 20px;">
        Subscription Automatically Renewed
    </h1>

    <!-- Greeting -->
    <p style="font-size: 16px; margin-bottom: 10px;">
        Hey <strong>{{name}}</strong>,
    </p>

    <!-- Main message -->
    <p style="font-size: 16px; line-height: 1.5; margin-bottom: 20px;">
        Your <strong>{{planName}}</strong> subscription has been <strong>automatically renewed</strong> 
        for {{amount}} {{currency}}.
    </p>

    <!-- Next billing info -->
    <p style="font-size: 16px; margin-bottom: 30px;">
        Your next billing date is <strong>{{nextBillingDate}}</strong>.
    </p>

    <!-- Success notice -->
    <div style="background-color: #f0fdf4; border-left: 4px solid #16a34a; padding: 20px; border-radius: 8px; margin: 20px 0;">
        <p style="color: #166534; margin: 0; font-size: 14px;">
            <strong>Auto-Renewal Successful:</strong> Your subscription continues uninterrupted. 
            Thank you for staying with CosmicForge!
        </p>
    </div>

    <!-- Sign off -->
    <p style="margin-top: 30px; font-size: 14px;">
        Thank you for staying with CosmicForge!<br>
        The CosmicForge Team
    </p>
</div>