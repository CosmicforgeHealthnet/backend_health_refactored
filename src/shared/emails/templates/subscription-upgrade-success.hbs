<div style="padding: 30px; font-family: Arial, sans-serif;">
    <!-- Heading -->
    <h1 style="font-size: 20px; font-weight: bold; margin-bottom: 20px;">
        Subscription Upgrade Successful
    </h1>

    <!-- Greeting -->
    <p style="font-size: 16px; margin-bottom: 10px;">
        Hey <strong>{{name}}</strong>,
    </p>

    <!-- Congratulations message -->
    <p style="font-size: 16px; line-height: 1.5; margin-bottom: 20px;">
        <strong>Congratulations!</strong> Your subscription has been upgraded to 
        <strong>{{planName}}</strong> ({{tier}}).
    </p>

    <!-- Features intro -->
    <p style="font-size: 16px; margin-bottom: 15px;">
        You now have access to:
    </p>

    <!-- Features List -->
    <div style="background-color: #F5F8FF; padding: 20px; border-radius: 8px; margin: 20px 0; border-left: 4px solid #3964EA;">
        <ul style="margin: 0; padding-left: 20px; color: #374151; font-size: 14px;">
            {{#each features}}
            <li style="margin-bottom: 8px;">{{this}}</li>
            {{/each}}
        </ul>
    </div>

    <!-- Instructions -->
    <p style="font-size: 16px; margin-bottom: 30px;">
        Start exploring your new features and enhanced capabilities right away.
    </p>

    <!-- Button -->
    <div style="text-align: center; margin: 30px 0;">
        {{> button url=dashboardUrl text="Go to Dashboard" }}
    </div>

    <!-- Fallback link -->
    <p style="font-size: 14px; color: #555; word-break: break-all; margin: 20px 0;">
        If the button doesn't work, copy and paste this link into your browser:<br />
        <a href="{{dashboardUrl}}" style="color: #272EA7;">{{dashboardUrl}}</a>
    </p>

    <!-- Sign off -->
    <p style="margin-top: 30px; font-size: 14px;">
        The CosmicForge Team
    </p>

</div>