<div style="padding: 30px; font-family: Arial, sans-serif;">
    <!-- Status Banner -->
    <div style="background: linear-gradient(135deg, #3964EA, #2548C7); text-align: center; padding: 20px; border-radius: 8px; margin-bottom: 30px;">
        <h2 style="margin: 0; font-size: 16px; color: white; font-weight: bold;">Consultation Starting Soon</h2>
    </div>

    <!-- Greeting -->
    <p style="font-size: 16px; margin-bottom: 10px;">
        Hey <strong>{{patientName}}</strong>,
    </p>

    <!-- Main message -->
    <p style="font-size: 16px; line-height: 1.5; margin-bottom: 30px;">
        Your consultation with <strong>Dr. {{doctorName}}</strong> starts in <strong>15 minutes</strong>. 
        Please prepare to join your consultation.
    </p>

    <!-- Meeting Access Card -->
    {{#if meetingLink}}
    <div style="background-color: #F5F8FF; border-left: 4px solid #3964EA; padding: 25px; border-radius: 8px; margin: 20px 0;">
        <h3 style="color: #3964EA; margin-top: 0; font-size: 16px; font-weight: bold; margin-bottom: 15px;">
            Join Your Consultation
        </h3>
        <p style="color: #4b5563; margin-bottom: 20px; font-size: 14px;">
            Consultation starts at {{appointmentTime}} • Appointment ID: #{{appointmentId}}
        </p>
        
        <div style="text-align: center; margin: 20px 0;">
            {{> button url=meetingLink text="Join Meeting" }}
        </div>
        
        {{#if meetingPassword}}
        <div style="margin-top: 15px; padding: 15px; background: rgba(57, 100, 234, 0.1); border-radius: 6px;">
            <p style="margin: 0; color: #3964EA; font-weight: 600; text-align: center;">
                <strong>Meeting Password:</strong> 
                <span style="font-family: monospace; background: #ffffff; padding: 6px 12px; border-radius: 4px; border: 2px solid #3964EA; margin-left: 10px;">{{meetingPassword}}</span>
            </p>
        </div>
        {{/if}}
    </div>
    {{/if}}

    <!-- Dashboard Link -->
    <div style="text-align: center; margin: 30px 0;">
        <a href="{{dashboardLink}}" style="color: #3964EA; text-decoration: none; font-weight: bold;">
             View My Appointments
        </a>
    </div>

    <!-- Pre-Consultation Checklist -->
    <div style="background-color: #fef3c7; border-left: 4px solid #f59e0b; padding: 20px; border-radius: 8px; margin: 20px 0;">
        <h3 style="color: #92400e; margin-top: 0; font-size: 16px; font-weight: bold; margin-bottom: 15px;">
            Pre-Consultation Checklist
        </h3>
        <ul style="color: #78350f; margin: 0; padding-left: 20px; font-size: 14px; line-height: 1.6;">
            <li>Camera and microphone working</li>
            <li>List of symptoms and questions ready</li>
            <li>Current medications list available</li>
            <li>Quiet, private space secured</li>
            <li>Insurance card and ID ready</li>
            <li>Phone on silent mode</li>
        </ul>
    </div>

    <!-- Health Tip -->
    <div style="background-color: #e0f2fe; border-left: 4px solid #0284c7; padding: 20px; border-radius: 8px; margin: 20px 0;">
        <p style="color: #0c4a6e; margin: 0; font-weight: 600; text-align: center; font-size: 14px;">
            <strong>Tip:</strong> Be honest and detailed about your symptoms. The more information you provide, 
            the better Dr. {{doctorName}} can help you.
        </p>
    </div>

    <!-- Urgent Note -->
    <div style="background-color: #fee2e2; border-left: 4px solid #ef4444; padding: 20px; border-radius: 8px; margin: 20px 0;">
        <p style="color: #dc2626; margin: 0; font-weight: 600; text-align: center; font-size: 14px;">
            Join now to test your connection before the consultation begins
        </p>
    </div>

    <!-- Support info -->
    <p style="font-size: 14px; color: #555; margin: 20px 0; text-align: center;">
        Having trouble joining? Visit our <a href="{{supportLink}}" style="color: #3964EA; text-decoration: none;">support center</a> for help
    </p>

    <!-- Sign off -->
    <p style="margin-top: 30px; font-size: 14px; text-align: center;">
        <strong>The CosmicForge Health Team</strong>
    </p>

</div>