<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <title>Reward Activated - CosmicForge Health</title>
</head>

<body style="margin: 0; padding: 0; background-color: #f4f4f4; color: black; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;">
    <table align="center" width="100%" cellpadding="0" cellspacing="0"
        style="max-width: 600px; background-color: #ffffff; margin: 40px auto; border-radius: 8px; box-shadow: 0 0 10px rgba(0,0,0,0.1); overflow: hidden;">
        
        <!-- Header -->
        <tr>
            <td style="padding: 30px; text-align: center; background: linear-gradient(135deg, #16a34a 0%, #15803d 100%);">
                <img src="https://backend.cosmicforge-healthnet.com/images/e47c6604-d9cc-4fb2-9c87-b4d9337c2156.png" alt="CosmicForge Health" style="max-height: 60px;">
            </td>
        </tr>

        <!-- Main Content -->
        <tr>
            <td style="padding: 40px 30px;">
                <div style="text-align: center; margin-bottom: 30px;">
                    <div style="background: linear-gradient(135deg, #16a34a 0%, #15803d 100%); color: white; padding: 12px 24px; border-radius: 25px; display: inline-block; font-weight: bold; font-size: 14px; margin-bottom: 20px;">
                        ✅ REWARD ACTIVATED
                    </div>
                </div>

                <h1 style="font-size: 24px; color: #333; margin: 0 0 20px 0; font-weight: 600; text-align: center;">
                    Your Reward is Ready to Use!
                </h1>
                
                <p style="font-size: 16px; line-height: 1.6; color: #555; margin: 0 0 20px 0; text-align: center;">
                    Congratulations! Your email has been verified successfully and your reward is now active. You can start using it immediately.
                </p>

                <!-- Active Reward Card -->
                <div style="background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); border-radius: 12px; padding: 25px; margin: 30px 0; border-left: 4px solid #16a34a;">
                    <h2 style="color: #15803d; margin: 0 0 20px 0; font-size: 18px; font-weight: 600;">
                        🎁 Your Active Reward
                    </h2>
                    
                    <table style="width: 100%; border-collapse: collapse;">
                        <tr>
                            <td style="padding: 8px 0; border-bottom: 1px solid #e5e7eb; font-weight: 600; color: #374151; width: 40%;">
                                Reward:
                            </td>
                            <td style="padding: 8px 0; border-bottom: 1px solid #e5e7eb; color: #1f2937;">
                                {{rewardDescription}}
                            </td>
                        </tr>
                        {{#if rewardValue}}
                        <tr>
                            <td style="padding: 8px 0; border-bottom: 1px solid #e5e7eb; font-weight: 600; color: #374151;">
                                Discount:
                            </td>
                            <td style="padding: 8px 0; border-bottom: 1px solid #e5e7eb; color: #16a34a; font-weight: bold; font-size: 18px;">
                                {{rewardValue}}% OFF
                            </td>
                        </tr>
                        {{/if}}
                        <tr>
                            <td style="padding: 8px 0; border-bottom: 1px solid #e5e7eb; font-weight: 600; color: #374151;">
                                Your Code:
                            </td>
                            <td style="padding: 8px 0; border-bottom: 1px solid #e5e7eb;">
                                <div style="background: #16a34a; color: white; padding: 12px; border-radius: 8px; text-align: center; font-family: monospace; font-weight: bold; font-size: 20px; letter-spacing: 2px;">
                                    {{rewardCode}}
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 8px 0; font-weight: 600; color: #374151;">
                                Activated:
                            </td>
                            <td style="padding: 8px 0; color: #16a34a; font-weight: 600;">
                                {{activatedAt}}
                            </td>
                        </tr>
                    </table>
                </div>

                <!-- How to Apply Reward -->
                <div style="background: linear-gradient(135deg, #f0f7ff 0%, #e0f2fe 100%); border-radius: 12px; padding: 25px; margin: 30px 0; border-left: 4px solid #2563eb;">
                    <h2 style="color: #1e40af; margin: 0 0 15px 0; font-size: 18px; font-weight: 600;">
                        💳 Ready to Use Your Discount?
                    </h2>
                    
                    <p style="color: #1e3a8a; margin: 0 0 20px 0; line-height: 1.6;">
                        Your reward is now ready! Apply it during checkout to get your discount on any subscription plan.
                    </p>
                    
                    <div style="text-align: center; margin: 20px 0;">
                        <a href="{{checkoutLink}}"
                            style="background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%); color: #ffffff; padding: 16px 32px; text-decoration: none; border-radius: 8px; font-weight: bold; font-size: 16px; display: inline-block; box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);">
                            🛒 Shop with Discount
                        </a>
                    </div>
                </div>

                <!-- Usage Instructions -->
                <div style="margin-top: 30px; padding: 20px; background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%); border-radius: 8px; border-left: 4px solid #f59e0b;">
                    <h3 style="color: #92400e; margin: 0 0 12px 0; font-size: 16px;">
                        📋 How to Apply Your Discount
                    </h3>
                    <ol style="color: #78350f; margin: 0; padding-left: 20px; line-height: 1.6;">
                        <li>Visit our subscription plans page</li>
                        <li>Choose your preferred plan</li>
                        <li>Enter code <strong>{{rewardCode}}</strong> at checkout</li>
                        <li>Your discount will be applied automatically</li>
                        <li>Complete your purchase and enjoy!</li>
                    </ol>
                </div>

                <!-- Code Copy Section -->
                <div style="margin-top: 25px; padding: 20px; background: linear-gradient(135deg, #f3f4f6 0%, #e5e7eb 100%); border-radius: 8px; text-align: center;">
                    <p style="color: #374151; margin: 0 0 10px 0; font-weight: 600;">
                        💾 Save this code for easy access:
                    </p>
                    <div style="background: white; border: 2px dashed #16a34a; padding: 15px; border-radius: 8px; font-family: monospace; font-size: 18px; font-weight: bold; color: #16a34a; letter-spacing: 1px;">
                        {{rewardCode}}
                    </div>
                    <p style="color: #6b7280; margin: 10px 0 0 0; font-size: 12px;">
                        Click to select and copy
                    </p>
                </div>

                <!-- Quick Actions -->
                <div style="text-align: center; margin: 30px 0;">
                    <a href="{{checkoutLink}}"
                        style="background: linear-gradient(135deg, #16a34a 0%, #15803d 100%); color: #ffffff; padding: 12px 24px; text-decoration: none; border-radius: 6px; font-weight: bold; margin: 0 10px; display: inline-block;">
                        🛍️ Start Shopping
                    </a>
                    <a href="{{dashboardLink}}"
                        style="background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%); color: #ffffff; padding: 12px 24px; text-decoration: none; border-radius: 6px; font-weight: bold; margin: 0 10px; display: inline-block;">
                        🎁 My Rewards
                    </a>
                </div>

                <p style="margin-top: 30px; font-size: 14px; color: #777; line-height: 1.5; text-align: center;">
                    Questions about using your reward? Visit our <a href="{{supportLink}}" style="color: #2563eb; text-decoration: none;">support center</a> or reply to this email.
                    <br><br>
                    <strong>The CosmicForge Health Team</strong>
                </p>
            </td>
        </tr>

        <!-- Footer -->
        <tr>
            <td style="padding: 20px; background: linear-gradient(135deg, #16a34a 0%, #15803d 100%); color: #ffffff; text-align: center; font-size: 12px;">
                <p style="margin: 0; opacity: 0.9;">
                    &copy; {{currentYear}} CosmicForge Health. All rights reserved.
                </p>
            </td>
        </tr>
    </table>
</body>

</html>