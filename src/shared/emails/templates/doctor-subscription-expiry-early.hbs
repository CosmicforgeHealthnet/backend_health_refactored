<div style="padding: 30px; font-family: Arial, sans-serif;">
    <!-- Heading -->
    <h1 style="font-size: 20px; font-weight: bold; margin-bottom: 20px;">
        Subscription Renewal Reminder
    </h1>

    <!-- Greeting -->
    <p style="font-size: 16px; margin-bottom: 10px;">
        Hey <strong>{{fullName}}</strong>,
    </p>

    <!-- Main message -->
    <p style="font-size: 16px; line-height: 1.5; margin-bottom: 30px;">
        Your <strong>{{planName}}</strong> subscription expires in 
        <strong>{{daysRemaining}} day(s)</strong>. Renew now to keep access to all consultation features.
    </p>

    <!-- Friendly reminder -->
    <div style="background-color: #F5F8FF; border-left: 4px solid #3964EA; padding: 20px; border-radius: 8px; margin: 20px 0;">
        <p style="color: #4b5563; margin: 0; font-size: 14px;">
            <strong>Friendly Reminder:</strong> Don't forget to renew your subscription to continue offering consultations to your patients. Keep serving those who need your expertise.
        </p>
    </div>

    <!-- Button -->
    <div style="text-align: center; margin: 30px 0;">
        {{> button url=link text="Renew Subscription" }}
    </div>

    <!-- Fallback link -->
    <p style="font-size: 14px; color: #555; word-break: break-all; margin: 20px 0;">
        If the button doesn't work, copy and paste this link into your browser:<br />
        <a href="{{link}}" style="color: #272EA7;">{{link}}</a>
    </p>

    <!-- Sign off -->
    <p style="margin-top: 30px; font-size: 14px;">
        The CosmicForge Team
    </p>

</div>