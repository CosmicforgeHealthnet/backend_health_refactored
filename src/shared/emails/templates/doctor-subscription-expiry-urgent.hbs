<div style="padding: 30px; font-family: Arial, sans-serif;">
    <!-- Heading -->
    <h1 style="font-size: 20px; font-weight: bold; margin-bottom: 20px;">
        Urgent: Subscription Expires Today
    </h1>

    <!-- Greeting -->
    <p style="font-size: 16px; margin-bottom: 10px;">
        Hey <strong>{{fullName}}</strong>,
    </p>

    <!-- Main message -->
    <p style="font-size: 16px; line-height: 1.5; margin-bottom: 30px;">
        Urgent: your <strong>{{planName}}</strong> subscription expires today. 
        Renew now or lose access to all premium features.
    </p>

    <!-- Urgent notice -->
    <div style="background-color: #fee2e2; border-left: 4px solid #ef4444; padding: 20px; border-radius: 8px; margin: 20px 0;">
        <p style="color: #dc2626; margin: 0; font-size: 14px;">
            <strong>Final Notice:</strong> Your subscription ends today! If you don't renew immediately, you won't be able to offer consultations to patients until you upgrade.
        </p>
    </div>

    <!-- Button -->
    <div style="text-align: center; margin: 30px 0;">
        {{> button url=link text="Renew Immediately" }}
    </div>

    <!-- Fallback link -->
    <p style="font-size: 14px; color: #555; word-break: break-all; margin: 20px 0;">
        If the button doesn't work, copy and paste this link into your browser:<br />
        <a href="{{link}}" style="color: #272EA7;">{{link}}</a>
    </p>

    <!-- Sign off -->
    <p style="margin-top: 30px; font-size: 14px;">
        The CosmicForge Team
    </p>

</div>