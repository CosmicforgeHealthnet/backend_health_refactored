<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <title>Reward Verification - CosmicForge Health</title>
</head>

<body style="margin: 0; padding: 0; background-color: #f4f4f4; color: black; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;">
    <table align="center" width="100%" cellpadding="0" cellspacing="0"
        style="max-width: 600px; background-color: #ffffff; margin: 40px auto; border-radius: 8px; box-shadow: 0 0 10px rgba(0,0,0,0.1); overflow: hidden;">
        
        <!-- Header -->
        <tr>
            <td style="padding: 30px; text-align: center; background: linear-gradient(135deg, #2563eb 0%, #1e40af 100%);">
                <img src="https://api.cosmicforge-healthnet.com/asset/cosmicforgelogo.png" alt="CosmicForge Health" style="max-height: 60px;">
            </td>
        </tr>

        <!-- Main Content -->
        <tr>
            <td style="padding: 40px 30px;">
                <div style="text-align: center; margin-bottom: 30px;">
                    <div style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color: white; padding: 12px 24px; border-radius: 25px; display: inline-block; font-weight: bold; font-size: 14px; margin-bottom: 20px;">
                        🎉 CONGRATULATIONS!
                    </div>
                </div>

                <h1 style="font-size: 24px; color: #333; margin: 0 0 20px 0; font-weight: 600; text-align: center;">
                    You've Won a Reward!
                </h1>
                
                <p style="font-size: 16px; line-height: 1.6; color: #555; margin: 0 0 20px 0; text-align: center;">
                    Great news! Our spinning wheel has selected you for an amazing reward. Verify your email below to claim it.
                </p>

                <!-- Reward Details Card -->
                <div style="background: linear-gradient(135deg, #f0f7ff 0%, #e0f2fe 100%); border-radius: 12px; padding: 25px; margin: 30px 0; border-left: 4px solid #2563eb;">
                    <h2 style="color: #1e40af; margin: 0 0 20px 0; font-size: 18px; font-weight: 600;">
                        🎁 Your Reward Details
                    </h2>
                    
                    <table style="width: 100%; border-collapse: collapse;">
                        <tr>
                            <td style="padding: 8px 0; border-bottom: 1px solid #e5e7eb; font-weight: 600; color: #374151; width: 40%;">
                                Reward:
                            </td>
                            <td style="padding: 8px 0; border-bottom: 1px solid #e5e7eb; color: #1f2937;">
                                {{rewardDescription}}
                            </td>
                        </tr>
                        {{#if rewardValue}}
                        <tr>
                            <td style="padding: 8px 0; border-bottom: 1px solid #e5e7eb; font-weight: 600; color: #374151;">
                                Discount:
                            </td>
                            <td style="padding: 8px 0; border-bottom: 1px solid #e5e7eb; color: #16a34a; font-weight: bold; font-size: 18px;">
                                {{rewardValue}}% OFF
                            </td>
                        </tr>
                        {{/if}}
                        <tr>
                            <td style="padding: 8px 0; border-bottom: 1px solid #e5e7eb; font-weight: 600; color: #374151;">
                                Reward Code:
                            </td>
                            <td style="padding: 8px 0; border-bottom: 1px solid #e5e7eb; color: #1f2937; font-family: monospace; font-weight: bold; font-size: 16px; background: #f3f4f6; padding: 4px 8px; border-radius: 4px;">
                                {{rewardCode}}
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 8px 0; font-weight: 600; color: #374151;">
                                Valid Until:
                            </td>
                            <td style="padding: 8px 0; color: #ef4444; font-weight: 600;">
                                {{expiresAt}}
                            </td>
                        </tr>
                    </table>
                </div>

                <!-- Verification Button -->
                <div style="background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); border-radius: 12px; padding: 25px; margin: 30px 0; border-left: 4px solid #16a34a;">
                    <h2 style="color: #15803d; margin: 0 0 15px 0; font-size: 18px; font-weight: 600;">
                        📧 Verify Your Email to Claim
                    </h2>
                    
                    <p style="color: #166534; margin: 0 0 20px 0; line-height: 1.6;">
                        Click the button below to verify your email address and activate your reward. This step ensures your reward is secure and ready to use.
                    </p>
                    
                    <div style="text-align: center; margin: 20px 0;">
                        <a href="{{verificationLink}}"
                            style="background: linear-gradient(135deg, #16a34a 0%, #15803d 100%); color: #ffffff; padding: 16px 32px; text-decoration: none; border-radius: 8px; font-weight: bold; font-size: 16px; display: inline-block; box-shadow: 0 4px 12px rgba(22, 163, 74, 0.3);">
                            ✅ Verify Email & Claim Reward
                        </a>
                    </div>
                </div>

                <!-- How to Use Instructions -->
                <div style="margin-top: 30px; padding: 20px; background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%); border-radius: 8px; border-left: 4px solid #f59e0b;">
                    <h3 style="color: #92400e; margin: 0 0 12px 0; font-size: 16px;">
                        💡 How to Use Your Reward
                    </h3>
                    <ol style="color: #78350f; margin: 0; padding-left: 20px; line-height: 1.6;">
                        <li>Click the verification button above</li>
                        <li>Save your reward code: <strong>{{rewardCode}}</strong></li>
                        <li>Visit our subscription page when ready to upgrade</li>
                        <li>Enter your reward code during checkout</li>
                        <li>Enjoy your discount on your subscription!</li>
                    </ol>
                </div>

                <!-- Important Note -->
                <div style="margin-top: 25px; padding: 15px; background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%); border-radius: 8px; border-left: 4px solid #ef4444;">
                    <p style="color: #dc2626; margin: 0; font-weight: 600; text-align: center;">
                        ⚠️ This reward expires in {{validityDays}} days. Don't miss out!
                    </p>
                </div>

                <!-- Quick Actions -->
                <div style="text-align: center; margin: 30px 0;">
                    <a href="{{dashboardLink}}"
                        style="background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%); color: #ffffff; padding: 12px 24px; text-decoration: none; border-radius: 6px; font-weight: bold; margin: 0 10px; display: inline-block;">
                        🎁 View My Rewards
                    </a>
                </div>

                <p style="margin-top: 30px; font-size: 14px; color: #777; line-height: 1.5; text-align: center;">
                    Need help? Visit our <a href="{{supportLink}}" style="color: #2563eb; text-decoration: none;">support center</a> or reply to this email.
                    <br><br>
                    <strong>The CosmicForge Health Team</strong>
                </p>

                <p style="margin-top: 20px; font-size: 12px; color: #999; text-align: center;">
                    If the button doesn't work, copy and paste this link into your browser:<br>
                    <a href="{{verificationLink}}" style="color: #2563eb; word-break: break-all;">{{verificationLink}}</a>
                </p>
            </td>
        </tr>

        <!-- Footer -->
        <tr>
            <td style="padding: 20px; background: linear-gradient(135deg, #2563eb 0%, #1e40af 100%); color: #ffffff; text-align: center; font-size: 12px;">
                <p style="margin: 0; opacity: 0.9;">
                    &copy; {{currentYear}} CosmicForge Health. All rights reserved.
                </p>
            </td>
        </tr>
    </table>
</body>

</html>