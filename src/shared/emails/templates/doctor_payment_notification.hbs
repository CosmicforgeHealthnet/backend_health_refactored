<div style="padding: 30px; font-family: Arial, sans-serif;"></div>
    <!-- Status Banner -->
    <div style="background: linear-gradient(135deg, #16a34a, #15803d); text-align: center; padding: 20px; border-radius: 8px; margin-bottom: 30px;">
        <h2 style="margin: 0; font-size: 16px; color: white; font-weight: bold;">Payment Received - Action Required</h2>
    </div>

    <!-- Greeting -->
    <p style="font-size: 16px; margin-bottom: 10px;">
        Hello <strong>Dr. {{doctorName}}</strong>,
    </p>

    <!-- Main message -->
    <p style="font-size: 16px; line-height: 1.5; margin-bottom: 30px;">
        Payment has been received for your upcoming appointment with <strong>{{patientName}}</strong>. Please review and approve the appointment to confirm your availability.
    </p>

    <!-- Payment Confirmation -->
    <div style="background-color: #f0fdf4; border-left: 4px solid #16a34a; padding: 20px; border-radius: 8px; margin: 20px 0;">
        <h3 style="color: #15803d; margin-top: 0; font-size: 16px; font-weight: bold; margin-bottom: 15px;">
            Payment Confirmed
        </h3>
        {{!-- <p style="font-size: 14px; margin: 5px 0; color: #166534;">
            <strong>Amount Paid:</strong> {{paymentAmount}}
        </p> --}}
        {{!-- <p style="font-size: 14px; margin: 5px 0; color: #166534;">
            <strong>Payment Method:</strong> {{paymentMethod}}
        </p>
        <p style="font-size: 14px; margin: 5px 0; color: #166534;">
            <strong>Payment ID:</strong> {{paymentId}}
        </p> --}}
        <p style="font-size: 14px; margin: 5px 0; color: #166534;">
            <strong>Paid At:</strong> {{paidAt}}
        </p>
    </div>

      <!-- Approval Button -->
    <div style="text-align: center; margin: 30px 0;">
        <a href="{{approveLink}}" style="background: #16a34a; color: white; padding: 15px 30px; text-decoration: none; border-radius: 8px; font-weight: bold; display: inline-block; margin-right: 10px;">
            Review & Approve Appointment
        </a>
    </div>

    <!-- Appointment Details -->
    <div style="background-color: #eff6ff; border-left: 4px solid #3b82f6; padding: 20px; border-radius: 8px; margin: 20px 0;">
        <h3 style="color: #1d4ed8; margin-top: 0; font-size: 16px; font-weight: bold; margin-bottom: 15px;">
            Appointment Details
        </h3>
        <p style="font-size: 14px; margin: 5px 0; color: #1e40af;">
            <strong>Patient:</strong> {{patientName}}
        </p>
        <p style="font-size: 14px; margin: 5px 0; color: #1e40af;">
            <strong>Date & Time:</strong> {{appointmentDate}} at {{appointmentTime}}
        </p>
        <p style="font-size: 14px; margin: 5px 0; color: #1e40af;">
            <strong>Duration:</strong> {{duration}} minutes
        </p>
        <p style="font-size: 14px; margin: 5px 0; color: #1e40af;">
            <strong>Consultation Type:</strong> {{consultationType}}
        </p>
        <p style="font-size: 14px; margin: 5px 0; color: #1e40af;">
            <strong>Appointment ID:</strong> #{{appointmentId}}
        </p>
    </div>

    <!-- Action Required -->
    <div style="background-color: #fef3c7; border-left: 4px solid #f59e0b; padding: 20px; border-radius: 8px; margin: 20px 0;">
        <h3 style="color: #92400e; margin-top: 0; font-size: 16px; font-weight: bold; margin-bottom: 15px;">
            Action Required
        </h3>
        <p style="color: #92400e; margin: 5px 0; font-size: 14px;">
            <strong>Please approve this appointment to confirm your availability.</strong>
        </p>
        <p style="color: #92400e; margin: 5px 0; font-size: 14px;">
            The patient has completed payment and is waiting for your confirmation.
        </p>
        <p style="color: #92400e; margin: 5px 0; font-size: 14px;">
            Once approved, a meeting link will can now be generated by you for consultation.
        </p>
    </div>

  

    <!-- Important Notes -->
    <div style="background-color: #fef2f2; border-left: 4px solid #ef4444; padding: 20px; border-radius: 8px; margin: 20px 0;">
        <h3 style="color: #dc2626; margin-top: 0; font-size: 16px; font-weight: bold; margin-bottom: 15px;">
            Important Notes
        </h3>
        <p style="color: #991b1b; margin: 5px 0; font-size: 14px;">
            • Please approve or decline before the appointment time
        </p>
        <p style="color: #991b1b; margin: 5px 0; font-size: 14px;">
            • If you decline, the patient will receive a full refund automatically
        </p>
        <p style="color: #991b1b; margin: 5px 0; font-size: 14px;">
            • Meeting links can only be generated after approval
        </p>
        <p style="color: #991b1b; margin: 5px 0; font-size: 14px;">
            • Unconfirmed appointments will be automatically cancelled and refunded
        </p>
    </div>

    <!-- Dashboard Link -->
    <div style="text-align: center; margin: 30px 0;">
        <a href="{{dashboardLink}}" style="color: #3964EA; text-decoration: none; font-weight: bold;">
            View All Appointments
        </a>
    </div>

</div>