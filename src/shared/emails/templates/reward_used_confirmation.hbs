<!-- src/emails/templates/reward_used_confirmation.hbs -->
<!-- ============================================ -->

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>Reward Applied Successfully - CosmicForge Health</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f4f4f4; color: black; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;">
    <table align="center" width="100%" cellpadding="0" cellspacing="0" style="max-width: 600px; background-color: #ffffff; margin: 40px auto; border-radius: 8px; box-shadow: 0 0 10px rgba(0,0,0,0.1); overflow: hidden;">
        <tr>
            <td style="padding: 30px; text-align: center; background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);">
                <img src="https://backend.cosmicforge-healthnet.com/images/e47c6604-d9cc-4fb2-9c87-b4d9337c2156.png" alt="CosmicForge Health" style="max-height: 60px;">
            </td>
        </tr>
        <tr>
            <td style="padding: 40px 30px;">
                <div style="text-align: center; margin-bottom: 30px;">
                    <div style="background: linear-gradient(135deg, #16a34a 0%, #15803d 100%); color: white; padding: 12px 24px; border-radius: 25px; display: inline-block; font-weight: bold; font-size: 14px; margin-bottom: 20px;">
                        🎊 REWARD APPLIED
                    </div>
                </div>

                <h1 style="font-size: 24px; color: #333; margin: 0 0 20px 0; font-weight: 600; text-align: center;">
                    Discount Successfully Applied!
                </h1>
                
                <p style="font-size: 16px; line-height: 1.6; color: #555; margin: 0 0 20px 0; text-align: center;">
                    Congratulations! Your reward has been successfully applied to your purchase. Thank you for choosing CosmicForge Health.
                </p>

                <!-- Used Reward Details -->
                <div style="background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); border-radius: 12px; padding: 25px; margin: 30px 0; border-left: 4px solid #16a34a;">
                    <h2 style="color: #15803d; margin: 0 0 20px 0; font-size: 18px; font-weight: 600;">
                        ✅ Applied Reward
                    </h2>
                    
                    <table style="width: 100%; border-collapse: collapse;">
                        <tr>
                            <td style="padding: 8px 0; border-bottom: 1px solid #e5e7eb; font-weight: 600; color: #374151; width: 40%;">
                                Reward:
                            </td>
                            <td style="padding: 8px 0; border-bottom: 1px solid #e5e7eb; color: #1f2937;">
                                {{rewardDescription}}
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 8px 0; border-bottom: 1px solid #e5e7eb; font-weight: 600; color: #374151;">
                                Code Used:
                            </td>
                            <td style="padding: 8px 0; border-bottom: 1px solid #e5e7eb; color: #6b7280; font-family: monospace;">
                                {{rewardCode}}
                            </td>
                        </tr>
                        {{#if discountAmount}}
                        <tr>
                            <td style="padding: 8px 0; border-bottom: 1px solid #e5e7eb; font-weight: 600; color: #374151;">
                                You Saved:
                            </td>
                            <td style="padding: 8px 0; border-bottom: 1px solid #e5e7eb; color: #16a34a; font-weight: bold; font-size: 18px;">
                                ${{discountAmount}}
                            </td>
                        </tr>
                        {{/if}}
                        <tr>
                            <td style="padding: 8px 0; font-weight: 600; color: #374151;">
                                Applied:
                            </td>
                            <td style="padding: 8px 0; color: #16a34a; font-weight: 600;">
                                {{usedAt}}
                            </td>
                        </tr>
                    </table>
                </div>

                <!-- Next Steps -->
                <div style="margin-top: 30px; padding: 20px; background: linear-gradient(135deg, #f0f7ff 0%, #e0f2fe 100%); border-radius: 8px; border-left: 4px solid #2563eb;">
                    <h3 style="color: #1e40af; margin: 0 0 12px 0; font-size: 16px;">
                        🎯 What's Next?
                    </h3>
                    <ul style="color: #1e3a8a; margin: 0; padding-left: 20px; line-height: 1.6;">
                        <li>Your subscription is now active with the discount applied</li>
                        <li>Keep an eye out for more spinning wheel opportunities</li>
                        <li>Explore all the features of your plan</li>
                        <li>Share your experience with friends and family</li>
                    </ul>
                </div>

                <div style="text-align: center; margin: 30px 0;">
                    <a href="{{dashboardLink}}" style="background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%); color: #ffffff; padding: 12px 24px; text-decoration: none; border-radius: 6px; font-weight: bold; margin: 0 10px; display: inline-block;">
                        📊 My Dashboard
                    </a>
                </div>

                <p style="margin-top: 30px; font-size: 14px; color: #777; line-height: 1.5; text-align: center;">
                    Thank you for choosing CosmicForge Health! <a href="{{supportLink}}" style="color: #2563eb; text-decoration: none;">Contact us</a> if you need any assistance.
                    <br><br>
                    <strong>The CosmicForge Health Team</strong>
                </p>
            </td>
        </tr>
        <tr>
            <td style="padding: 20px; background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%); color: #ffffff; text-align: center; font-size: 12px;">
                <p style="margin: 0; opacity: 0.9;">
                    &copy; {{currentYear}} CosmicForge Health. All rights reserved.
                </p>
            </td>
        </tr>
    </table>
</body>
</html>
