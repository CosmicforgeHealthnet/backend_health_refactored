<div style="padding: 30px; font-family: Arial, sans-serif;">
    <!-- Status Banner -->
    <div style="background: linear-gradient(135deg, #f97316, #ea580c); text-align: center; padding: 20px; border-radius: 8px; margin-bottom: 30px;">
        <h2 style="margin: 0; font-size: 16px; color: white; font-weight: bold;">Appointment Reminder</h2>
    </div>

    <!-- Greeting -->
    <p style="font-size: 16px; margin-bottom: 10px;">
        Hey <strong>Dr. {{doctorName}}</strong>,
    </p>

    <!-- Main message -->
    <p style="font-size: 16px; line-height: 1.5; margin-bottom: 30px;">
        You have an upcoming appointment with <strong>{{patientName}}</strong> in <strong>1 hour</strong>.
    </p>

    <!-- Appointment Details -->
    <div style="background-color: #F5F8FF; border-left: 4px solid #3964EA; padding: 20px; border-radius: 8px; margin: 20px 0;">
        <h3 style="color: #3964EA; margin-top: 0; font-size: 16px; font-weight: bold; margin-bottom: 15px;">
            Appointment Details
        </h3>
        <p style="font-size: 14px; margin: 5px 0; color: #4b5563;">
            <strong>Patient:</strong> {{patientName}}
        </p>
        <p style="font-size: 14px; margin: 5px 0; color: #4b5563;">
            <strong>Date & Time:</strong> {{appointmentDate}} at {{appointmentTime}}
        </p>
        <p style="font-size: 14px; margin: 5px 0; color: #4b5563;">
            <strong>Duration:</strong> {{duration}} minutes
        </p>
        <p style="font-size: 14px; margin: 5px 0; color: #4b5563;">
            <strong>Type:</strong> {{consultationType}}
        </p>
        <p style="font-size: 14px; margin: 5px 0; color: #4b5563;">
            <strong>Appointment ID:</strong> #{{appointmentId}}
        </p>
    </div>

    <!-- Meeting Access -->
    {{#if meetingLink}}
    <div style="background-color: #f0fdf4; border-left: 4px solid #16a34a; padding: 20px; border-radius: 8px; margin: 20px 0;">
        <h3 style="color: #15803d; margin-top: 0; font-size: 16px; font-weight: bold; margin-bottom: 15px;">
            Join Meeting
        </h3>
        
        <div style="text-align: center; margin: 20px 0;">
            {{> button url=meetingLink text="Start Meeting" }}
        </div>
        
        {{#if meetingPassword}}
        <p style="margin: 15px 0 0 0; padding: 12px; background: rgba(22, 163, 74, 0.1); border-radius: 6px; text-align: center;">
            <strong>Meeting Password:</strong> <span style="font-family: monospace; background: #ffffff; padding: 4px 8px; border-radius: 4px; border: 1px solid #d1d5db;">{{meetingPassword}}</span>
        </p>
        {{/if}}
    </div>
    {{/if}}

    <!-- Dashboard Link -->
    <div style="text-align: center; margin: 30px 0;">
        <a href="{{dashboardLink}}" style="color: #3964EA; text-decoration: none; font-weight: bold;">
            📋 View Dashboard
        </a>
    </div>

    <!-- Pre-Meeting Checklist -->
    <div style="background-color: #fef3c7; border-left: 4px solid #f59e0b; padding: 20px; border-radius: 8px; margin: 20px 0;">
        <h3 style="color: #92400e; margin-top: 0; font-size: 16px; font-weight: bold; margin-bottom: 15px;">
            Pre-Meeting Checklist
        </h3>
        <ul style="color: #78350f; margin: 0; padding-left: 20px; font-size: 14px; line-height: 1.6;">
            <li>Review patient's medical history and previous notes</li>
            <li>Prepare necessary documents or test results</li>
            <li>Test your camera and microphone</li>
            <li>Find a quiet, private space with good lighting</li>
            <li>Have your prescription pad or digital tools ready</li>
        </ul>
    </div>

    <!-- Support info -->
    <p style="font-size: 14px; color: #555; margin: 20px 0; text-align: center;">
        Need help? Visit our <a href="{{supportLink}}" style="color: #3964EA; text-decoration: none;">support center</a> or reply to this email.
    </p>

    <!-- Sign off -->
    <p style="margin-top: 30px; font-size: 14px; text-align: center;">
        <strong>The CosmicForge Health Team</strong>
    </p>

</div>