<div style="padding: 30px; font-family: Arial, sans-serif;">
    <!-- Heading -->
    <h1 style="font-size: 20px; font-weight: bold; margin-bottom: 20px;">
        Password Reset
    </h1>

    <!-- Greeting -->
    <p style="font-size: 16px; margin-bottom: 10px;">
        Hi <strong>{{fullName}}</strong>,
    </p>

    <!-- Intro message -->
    <p style="font-size: 16px; line-height: 1.5; margin-bottom: 20px;">
        You requested a password reset for your <strong>CosmicForge</strong> account. Don't worry, it happens to the best of us!
    </p>

    <!-- Instructions -->
    <p style="font-size: 16px; margin-bottom: 30px;">
        Click the button below to set a new password:
    </p>

    <!-- Button -->
        {{> button url=link text="Reset My Password" }}

    <!-- Expiry notice -->
    <p style="font-size: 14px; color: #555; margin-top: 20px;">
        This link will expire in <strong>{{expiresInMinutes}}</strong> minutes.
    </p>

    <!-- Security notice -->
    <p style="font-size: 14px; color: #555; margin-top: 15px;">
        If you didn't request a password reset, feel free to ignore this email. Your account is safe.
    </p>

</div>