<div style="padding: 30px; font-family: Arial, sans-serif;">
    <!-- Heading -->
    <h1 style="font-size: 20px; font-weight: bold; margin-bottom: 20px;">
        Complete Your Withdrawal
    </h1>

    <!-- Greeting -->
    <p style="font-size: 16px; margin-bottom: 10px;">
        Hey <strong>{{fullName}}</strong>,
    </p>

    <!-- Main message -->
    <p style="font-size: 16px; line-height: 1.5; margin-bottom: 20px;">
        Your withdrawal of <strong>{{currency}} {{amount}}</strong> to <strong>{{accountName}}</strong> 
        has been initiated successfully!
    </p>

    <!-- Instructions -->
    <p style="font-size: 16px; margin-bottom: 30px;">
        To complete your withdrawal, please use the verification code below:
    </p>

    <!-- OTP Code Display -->
    <div style="background: linear-gradient(135deg, #3964EA, #2548C7); border-radius: 12px; padding: 30px; margin: 30px 0; text-align: center;">
        <p style="font-size: 14px; margin: 0 0 10px 0; color: #ffffff; opacity: 0.9;">Your Verification Code:</p>
        <div style="background-color: rgba(255,255,255,0.15); border: 2px dashed rgba(255,255,255,0.5); padding: 20px; border-radius: 8px; margin: 15px 0;">
            <p style="font-size: 36px; font-weight: bold; color: #ffffff; margin: 0; letter-spacing: 6px; font-family: 'Courier New', monospace;">
                {{otpCode}}
            </p>
        </div>
        <p style="font-size: 13px; margin: 10px 0 0 0; color: #ffffff; opacity: 0.8;">
            <strong>Expires in {{expiresInMinutes}} minutes</strong>
        </p>
    </div>

    <!-- Button -->
    <div style="text-align: center; margin: 30px 0;">
        {{> button url=otpCompletionUrl text="Complete Withdrawal" }}
    </div>

    <!-- Withdrawal Details -->
    <div style="background-color: #F5F8FF; border-left: 4px solid #3964EA; padding: 20px; border-radius: 8px; margin: 20px 0;">
        <h3 style="color: #3964EA; margin-top: 0; font-size: 16px; font-weight: bold; margin-bottom: 15px;">
            Withdrawal Details
        </h3>
        <p style="font-size: 14px; margin: 5px 0; color: #4b5563;">
            <strong>Amount:</strong> {{currency}} {{amount}}
        </p>
        <p style="font-size: 14px; margin: 5px 0; color: #4b5563;">
            <strong>Account:</strong> {{accountName}}
        </p>
        <p style="font-size: 14px; margin: 5px 0; color: #4b5563;">
            <strong>Reference:</strong> #{{withdrawalId}}
        </p>
    </div>

    <!-- Fallback Link -->
    <div style="background-color: #f3f4f6; padding: 15px; border-radius: 6px; margin: 20px 0;">
        <p style="font-size: 13px; color: #6b7280; margin: 0; word-break: break-all;">
            If the button doesn't work, copy and paste this link into your browser:<br />
            <a href="{{otpCompletionUrl}}" style="color: #272EA7; text-decoration: underline;">{{otpCompletionUrl}}</a>
        </p>
    </div>

    <!-- Security Notice -->
    <div style="background-color: #fef3c7; border-left: 4px solid #f59e0b; padding: 15px; border-radius: 6px; margin: 20px 0;">
        <p style="font-size: 14px; margin: 0; color: #92400e;">
            <strong>Security Notice:</strong> This is a secure withdrawal verification code generated by CosmicForge. 
            Never share this code with anyone. If you didn't request this withdrawal, please contact our support team immediately.
        </p>
    </div>

    <!-- Sign off -->
    <p style="margin-top: 30px; font-size: 14px;">
        Best regards,<br>
        <strong>The CosmicForge Team</strong>
    </p>

</div>