<div style="padding: 30px; font-family: Arial, sans-serif;">
    <!-- Success Icon -->
    <div style="text-align: center; margin-bottom: 30px;">
        <div style="width: 80px; height: 80px; background: linear-gradient(135deg, #10b981, #059669); border-radius: 50%; margin: 0 auto; display: inline-flex; align-items: center; justify-content: center; box-shadow: 0 4px 20px rgba(16, 185, 129, 0.3);">
            <span style="font-size: 40px; color: white;">✓</span>
        </div>
    </div>

    <!-- Heading -->
    <h1 style="font-size: 20px; font-weight: bold; margin-bottom: 20px; text-align: center; color: #10b981;">
        Password Reset Successful!
    </h1>

    <!-- Greeting -->
    <p style="font-size: 16px; margin-bottom: 10px; text-align: center;">
        Hey <strong>{{fullName}}</strong>,
    </p>

    <!-- Main message -->
    <p style="font-size: 16px; line-height: 1.5; margin-bottom: 30px; text-align: center;">
        Your wallet password has been successfully reset and updated.
    </p>

    <!-- Reset Details -->
    <div style="background: linear-gradient(135deg, #f0fdf4, #dcfce7); border-left: 4px solid #10b981; padding: 25px; border-radius: 8px; margin: 30px 0;">
        <p style="font-size: 14px; margin: 0 0 15px 0; font-weight: bold; color: #166534;">
            Reset Details:
        </p>
        <p style="font-size: 14px; margin: 5px 0; color: #166534;">
            <strong>Date & Time:</strong> {{resetTime}}
        </p>
        <p style="font-size: 14px; margin: 5px 0; color: #166534;">
            <strong>Account:</strong> {{fullName}}
        </p>
        <p style="font-size: 14px; margin: 5px 0; color: #166534;">
            <strong>Security Status:</strong> All systems secure ✓
        </p>
    </div>

    <!-- Next Steps -->
    <div style="background-color: #eff6ff; border-left: 4px solid #3b82f6; padding: 20px; border-radius: 6px; margin: 25px 0;">
        <p style="font-size: 14px; margin: 0 0 15px 0; font-weight: bold; color: #1e40af;">
            What's Next?
        </p>
        <ul style="font-size: 14px; color: #1e40af; margin: 0; padding-left: 20px;">
            <li>You can now use your new password for wallet operations</li>
            <li>We recommend logging in to test your new password</li>
            <li>Keep your password secure and don't share it with anyone</li>
        </ul>
    </div>

    <!-- Action Buttons -->
    <div style="text-align: center; margin: 35px 0;">
        {{> button url=loginUrl text="Login Now" }}
    </div>

    <!-- Security Tips -->
    <div style="background-color: #fefce8; border-left: 4px solid #eab308; padding: 20px; border-radius: 6px; margin: 25px 0;">
        <p style="font-size: 14px; margin: 0 0 15px 0; font-weight: bold; color: #a16207;">
            Security Tips:
        </p>
        <ul style="font-size: 13px; color: #a16207; margin: 0; padding-left: 20px; line-height: 1.5;">
            <li>Use a strong, unique password for your wallet</li>
            <li>Never share your wallet password with anyone</li>
            <li>Enable two-factor authentication if available</li>
            <li>Contact us immediately if you notice suspicious activity</li>
        </ul>
    </div>

    <!-- Suspicious Activity Notice -->
    <div style="background-color: #fee2e2; border-left: 4px solid #ef4444; padding: 20px; border-radius: 6px; margin: 25px 0;">
        <p style="font-size: 14px; margin: 0; color: #dc2626;">
            <strong>Didn't reset your password?</strong><br>
            If you didn't request this password reset, your account may be compromised. Please contact our
            security team immediately at <strong>security@cosmicforge.com</strong> or through our support
            center.
        </p>
    </div>

    <!-- Sign off -->
    <p style="font-size: 14px; color: #6b7280; margin-top: 30px; text-align: center;">
        Thank you for keeping your account secure!<br>
        <strong>The CosmicForge Security Team</strong>
    </p>

</div>