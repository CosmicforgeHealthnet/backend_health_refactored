<div style="padding: 30px; font-family: Arial, sans-serif;">
    <!-- Heading -->
    <h1 style="font-size: 20px; font-weight: bold; margin-bottom: 20px;">
        Subscription Downgraded
    </h1>

    <!-- Greeting -->
    <p style="font-size: 16px; margin-bottom: 10px;">
        Hey <strong>{{fullName}}</strong>,
    </p>

    <!-- Main message -->
    <p style="font-size: 16px; line-height: 1.5; margin-bottom: 30px;">
        Your <strong>{{planName}}</strong> subscription has expired and been downgraded to the Free plan. 
        Upgrade anytime to restore full features.
    </p>

    <!-- Button -->
    <div style="text-align: center; margin: 30px 0;">
        {{> button url=link text="View Plans" }}
    </div>

    <!-- Fallback link -->
    <p style="font-size: 14px; color: #555; word-break: break-all; margin: 20px 0;">
        If the button doesn't work, copy and paste this link into your browser:<br />
        <a href="{{link}}" style="color: #272EA7;">{{link}}</a>
    </p>

    <!-- Sign off -->
    <p style="margin-top: 30px; font-size: 14px;">
        The CosmicForge Team
    </p>

</div>