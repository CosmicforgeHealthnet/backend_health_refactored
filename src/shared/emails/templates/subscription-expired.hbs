<div style="padding: 30px; font-family: Arial, sans-serif;">
    <!-- Heading -->
    <h1 style="font-size: 20px; font-weight: bold; margin-bottom: 20px;">
        Subscription Expired
    </h1>

    <!-- Greeting -->
    <p style="font-size: 16px; margin-bottom: 10px;">
        Hey <strong>{{fullName}}</strong>,
    </p>

    <!-- Main message -->
    <p style="font-size: 16px; line-height: 1.5; margin-bottom: 30px;">
        Your subscription has expired. Please renew to regain access to all premium features 
        and continue enjoying your <strong>CosmicForge</strong> experience.
    </p>

       {{!-- <p style="font-size: 16px;">Your subscription expires in <strong>{{daysRemaining}}</strong> day(s). Renew now to keep access.</p> --}}

    <!-- Alert notice -->
    <div style="background-color: #fee2e2; border-left: 4px solid #ef4444; padding: 20px; border-radius: 8px; margin: 20px 0;">
        <p style="font-size: 14px; margin: 0; color: #dc2626;">
            <strong>Access Restricted:</strong> Your subscription has expired and some features may be limited. 
            Renew now to restore full access.
        </p>
    </div>

    <!-- Button -->
    <div style="text-align: center; margin: 30px 0;">
        {{> button url=link text="Renew Subscription" }}
    </div>

    <!-- Fallback link -->
    <p style="font-size: 14px; color: #555; word-break: break-all; margin: 20px 0;">
        If the button doesn't work, copy and paste this link into your browser:<br />
        <a href="{{link}}" style="color: #272EA7;">{{link}}</a>
    </p>

    <!-- Support message -->
    <p style="font-size: 14px; color: #555; margin: 20px 0;">
        Questions about your subscription? Contact our support team for assistance.
    </p>

    <!-- Sign off -->
    <p style="margin-top: 30px; font-size: 14px;">
        The CosmicForge Team
    </p>

</div>