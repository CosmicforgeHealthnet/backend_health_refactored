<!-- src/emails/partials/verification-status.hbs -->
<div class="verification-status" style="text-align: center; margin: 30px 0;">
    {{
#if
 (eq status "approved")}}
    <div style="color: #28a745; font-size: 48px; margin-bottom: 15px;">✅</div>
    <h2 style="color: #28a745; margin-bottom: 10px;">Verification Approved!</h2>
    <p style="color: #666; font-size: 16px;">Your medical license has been successfully verified.</p>
    {{
/if
}}
    
    {{
#if
 (eq status "rejected")}}
    <div style="color: #dc3545; font-size: 48px; margin-bottom: 15px;">❌</div>
    <h2 style="color: #dc3545; margin-bottom: 10px;">Verification Rejected</h2>
    <p style="color: #666; font-size: 16px;">Please review the feedback and resubmit your documents.</p>
    {{
/if
}}
    
    {{
#if
 (eq status "pending")}}
    <div style="color: #ffc107; font-size: 48px; margin-bottom: 15px;">⏳</div>
    <h2 style="color: #ffc107; margin-bottom: 10px;">Verification Pending</h2>
    <p style="color: #666; font-size: 16px;">We've received your documents and will review them soon.</p>
    {{
/if
}}
</div>
