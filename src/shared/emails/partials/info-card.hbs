<!-- src/emails/partials/info-card.hbs -->
<div class="info-card" style="background-color: #f8f9fa; border-left: 4px solid #667eea; padding: 20px; margin: 20px 0; border-radius: 0 6px 6px 0;">
    {{
#if
 title}}
    <h3 style="margin: 0 0 10px 0; color: #333;">{{title}}</h3>
    {{
/if
}}
    
    {{
#if
 content}}
    <p style="margin: 0; color: #666;">{{content}}</p>
    {{
/if
}}
    
    {{
#if
 items}}
    <ul style="margin: 10px 0 0 0; color: #666;">
        {{
#each
 items}}
        <li style="margin-bottom: 5px;">{{this}}</li>
        {{
/each
}}
    </ul>
    {{
/if
}}
</div>