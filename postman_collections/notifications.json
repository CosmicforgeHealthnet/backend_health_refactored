{
    "info": {
        "name": "CosmicForge - Notifications Feature",
        "description": "User notifications and alerts management API endpoints",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:3000",
            "type": "string"
        }
    ],
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{accessToken}}",
                "type": "string"
            }
        ]
    },
    "item": [
        {
            "name": "Get notifications",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/api/notifications?type=all&isRead=all&limit=20&skip=0",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "notifications"
                    ],
                    "query": [
                        {
                            "key": "type",
                            "value": "all",
                            "description": "Filter type: all, notification, alert"
                        },
                        {
                            "key": "isRead",
                            "value": "all",
                            "description": "Filter by read status: all, read, unread"
                        },
                        {
                            "key": "limit",
                            "value": "20",
                            "description": "Number of notifications to retrieve"
                        },
                        {
                            "key": "skip",
                            "value": "0",
                            "description": "Number of notifications to skip (pagination)"
                        }
                    ]
                },
                "description": "Get notifications with filtering options"
            }
        },
        {
            "name": "Get notification counts",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/api/notifications/counts",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "notifications",
                        "counts"
                    ]
                },
                "description": "Get notification counts (total, unread, etc.)"
            }
        },
        {
            "name": "Mark notification as read",
            "request": {
                "method": "PUT",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/api/notifications/:id/read",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "notifications",
                        ":id",
                        "read"
                    ],
                    "variable": [
                        {
                            "key": "id",
                            "value": "",
                            "description": "Notification UUID"
                        }
                    ]
                },
                "description": "Mark a single notification as read"
            }
        },
        {
            "name": "Mark all as read",
            "request": {
                "method": "PUT",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/api/notifications/read-all",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "notifications",
                        "read-all"
                    ]
                },
                "description": "Mark all notifications as read"
            }
        },
        {
            "name": "Delete notification",
            "request": {
                "method": "DELETE",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/api/notifications/:id",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "notifications",
                        ":id"
                    ],
                    "variable": [
                        {
                            "key": "id",
                            "value": "",
                            "description": "Notification UUID"
                        }
                    ]
                },
                "description": "Delete a notification"
            }
        },
        {
            "name": "Create notification",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"userId\": \"user-uuid\",\n  \"type\": \"notification\",\n  \"title\": \"Appointment Reminder\",\n  \"message\": \"Your appointment is in 1 hour\",\n  \"data\": {\n    \"appointmentId\": \"appointment-uuid\"\n  }\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/notifications",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "notifications"
                    ]
                },
                "description": "Create a new notification"
            }
        }
    ]
}